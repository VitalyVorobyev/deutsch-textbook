{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "ignorePatterns": [
    "/content/",
    "/data/",
    "/docs/",
    "/progress/",
    "/public/",
    "/dist/",
    "**/dist/",
    "**/.astro/",
    "/src-tauri/",
    "**/src-tauri/",
    "/apps/tonwerk/engine/",
    "/ds-bundle/",
    "/.ds-sync/",
    "/.claude/",
    "/.agents/",
    "/sources/",
    "/migrations/",
    "/packages/schema/schemas/",
    "**/*.mdx",
    "**/*.md",
    "**/*.astro",
    "**/*.yaml",
    "**/*.yml",
    "**/*.css",
    "**/*.html",
    "**/*.toml"
  ]
}
