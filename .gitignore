# macOS
.DS_Store

# logs
npm-debug.log*

# The official Wortliste PDFs are copyrighted transcription sources — never committed.
docs/Goethe-Zertifikat_B1_Wortliste.pdf

# Official Goethe-Institut exam sets (PDFs, audio, video) and everything derived from
# them — sliced audio, rendered task pages, the local exam manifest — are copyrighted.
# The exam trainer (ADR 0009) reads them from these local paths; they never enter the repo.
docs/GeotheInstitute/
sources/goethe-exams/
public/exams/

# design-sync (claude.ai/design)
.ds-sync/
ds-bundle/
.design-sync/.cache/

# Local credentials — Cloudflare R2 today. Never committed; the deploy reads
# CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID from repository secrets instead.
setenv.sh

# Large local ML checkpoints
.models/
.private/
.design-sync/learnings/
.design-sync/node_modules

# Tonwerk engine: local Python state
apps/tonwerk/engine/.venv/
apps/tonwerk/engine/.mypy_cache/
apps/tonwerk/engine/.pytest_cache/
apps/tonwerk/engine/.ruff_cache/
__pycache__/

feedback.md
# Screenshots attached to the feedback inbox — private, like feedback.md itself.
/IMG_*.jpeg
/IMG_*.png

# Learner snapshots are personal data and stay local; the live state syncs through R2
# (`bun run progress:pull`). Only the synthetic `test` profile and the README are tracked.
/progress/*
!/progress/README.md
!/progress/test/
