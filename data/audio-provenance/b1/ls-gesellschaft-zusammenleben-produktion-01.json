    "script": [
      {
        "display_text": "So, wir haben jetzt alle drei Vorschläge gehört. Ich bitte um Ihre Stimmen.",
        "id": "line-1",
        "pace": 0.79,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Frau Kolb",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Obwohl mir der Garten besser gefällt, stimme ich für den Spielplatz.",
        "id": "line-2",
        "pace": 0.86,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Herr Weber",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Ich schließe mich Herrn Weber an.",
        "id": "line-3",
        "pace": 0.83,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Frau Adamek",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Acht Stimmen dafür, drei dagegen. Die Mehrheit ist für den Spielplatz.",
