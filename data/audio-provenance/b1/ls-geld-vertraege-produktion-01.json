    "script": [
      {
        "display_text": "Kundendienst der Firma Lindner, guten Tag.",
        "id": "line-1",
        "pace": 0.86,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Kundendienst",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Guten Tag, ich habe eine Frage zu meiner Rechnung. Der Gesamtbetrag ist hundertvierzig Euro, aber in Zeile drei steht eine Anfahrt für dreißig Euro. Im Kostenvoranschlag stand davon nichts.",
        "id": "line-2",
        "pace": 0.77,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Anrufer",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Einen Moment, ich sehe nach. Sie haben recht, die Anfahrt ist dort nicht angegeben. Wir streichen die Zeile und schicken Ihnen morgen eine neue Rechnung über hundertzehn Euro.",
        "id": "line-3",
        "pace": 0.86,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Kundendienst",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Und bis wann muss ich dann zahlen?",
        "id": "line-4",
        "pace": 0.77,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Anrufer",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Das Datum bleibt, wie es ist: fällig am siebzehnten Mai. Bitte überweisen Sie erst, wenn die neue Rechnung da ist.",
        "id": "line-5",
        "pace": 0.86,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Kundendienst",
        "seed_override": null,
        "synthesis_text": null
      }
    ],
