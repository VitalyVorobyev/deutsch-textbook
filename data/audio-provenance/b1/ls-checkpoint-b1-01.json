    "script": [
      {
        "display_text": "Frau Kranz, Sie sind vor drei Jahren nach Leipzig gezogen. Was war am Anfang am schwersten?",
        "id": "line-1",
        "pace": 0.89,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Moderatorin",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Ehrlich gesagt nicht die Arbeit. Eine Wohnung hatte ich schnell gefunden, und die Kollegen waren von Anfang an freundlich. Schwer war, dass ich abends niemanden kannte. Erst als ich im Chor angefangen habe, wurde es besser.",
        "id": "line-2",
        "pace": 0.86,
