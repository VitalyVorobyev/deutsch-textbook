    "script": [
      {
        "display_text": "Hallo, hier ist Frau Ritter von oben. Ich erreiche Herrn Klein nicht — können Sie ihm etwas ausrichten?",
        "id": "line-1",
        "pace": 0.86,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Frau Ritter",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Natürlich, ich sage es ihm heute Abend.",
        "id": "line-2",
        "pace": 0.76,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Nachbar",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Die Handwerker kommen doch nicht am Dienstag, sondern erst am Donnerstag. Und er soll den Schlüssel bis Mittwoch im Büro abgeben.",
        "id": "line-3",
        "pace": 0.86,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Frau Ritter",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Also Donnerstag statt Dienstag, und der Schlüssel bis Mittwoch ins Büro. Habe ich das richtig verstanden?",
        "id": "line-4",
        "pace": 0.76,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Nachbar",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Genau. Die Uhrzeit bleibt, wie sie war: acht Uhr morgens.",
        "id": "line-5",
        "pace": 0.86,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Frau Ritter",
        "seed_override": null,
        "synthesis_text": null
      }
