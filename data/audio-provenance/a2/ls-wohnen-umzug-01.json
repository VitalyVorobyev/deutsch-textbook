    "lines": [
      {
        "display_text": "Guten Tag Frau Dorn, ich ziehe am Samstag um. Ich wollte kurz Bescheid sagen.",
        "id": "line-1",
        "pace": 0.95,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "seed": 100,
        "speaker": "Herr Yilmaz",
        "style": "Sprich freundlich und alltagsnah, wie unter Nachbarn im Treppenhaus.",
        "synthesis_text": null,
        "voice": "Uncle_Fu"
      },
      {
        "display_text": "Danke, das ist nett. Wann kommt der Wagen?",
        "id": "line-2",
        "pace": 0.95,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "seed": 105,
        "speaker": "Frau Dorn",
        "style": "Sprich freundlich und alltagsnah, wie unter Nachbarn im Treppenhaus.",
        "synthesis_text": null,
        "voice": "Sohee"
      },
      {
        "display_text": "Gegen acht Uhr morgens. Könnten Sie Ihr Auto vor dem Haus wegfahren?",
        "id": "line-3",
        "pace": 0.95,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "seed": 100,
        "speaker": "Herr Yilmaz",
        "style": "Sprich freundlich und alltagsnah, wie unter Nachbarn im Treppenhaus.",
        "synthesis_text": null,
        "voice": "Uncle_Fu"
      },
      {
        "display_text": "Natürlich. Ich stelle es am Freitagabend in die Seitenstraße.",
        "id": "line-4",
        "pace": 0.95,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "seed": 105,
        "speaker": "Frau Dorn",
        "style": "Sprich freundlich und alltagsnah, wie unter Nachbarn im Treppenhaus.",
        "synthesis_text": null,
        "voice": "Sohee"
      },
      {
        "display_text": "Vielen Dank. Wir brauchen den Platz nur bis Mittag.",
        "id": "line-5",
        "pace": 0.95,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "seed": 100,
        "speaker": "Herr Yilmaz",
        "style": "Sprich freundlich und alltagsnah, wie unter Nachbarn im Treppenhaus.",
        "synthesis_text": null,
        "voice": "Uncle_Fu"
      },
      {
        "display_text": "Und der Aufzug? Der ist oft besetzt.",
        "id": "line-6",
        "pace": 0.95,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "seed": 105,
        "speaker": "Frau Dorn",
        "style": "Sprich freundlich und alltagsnah, wie unter Nachbarn im Treppenhaus.",
        "synthesis_text": null,
        "voice": "Sohee"
      },
      {
        "display_text": "Den habe ich für Samstag reserviert, von acht bis zwölf.",
        "id": "line-7",
        "pace": 0.95,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "seed": 100,
        "speaker": "Herr Yilmaz",
        "style": "Sprich freundlich und alltagsnah, wie unter Nachbarn im Treppenhaus.",
        "synthesis_text": null,
        "voice": "Uncle_Fu"
      },
      {
        "display_text": "Sehr gut. Sagen Sie Bescheid, wenn Sie noch Hilfe brauchen.",
        "id": "line-8",
        "pace": 0.95,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "seed": 105,
        "speaker": "Frau Dorn",
        "style": "Sprich freundlich und alltagsnah, wie unter Nachbarn im Treppenhaus.",
        "synthesis_text": null,
        "voice": "Sohee"
      },
      {
        "display_text": "Das ist lieb. Am Nachmittag wird es sicher ruhiger.",
        "id": "line-9",
        "pace": 0.95,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "seed": 100,
        "speaker": "Herr Yilmaz",
        "style": "Sprich freundlich und alltagsnah, wie unter Nachbarn im Treppenhaus.",
        "synthesis_text": null,
        "voice": "Uncle_Fu"
      },
      {
        "display_text": "Ich bin ab zehn zu Hause und kann Ihnen Kaffee kochen.",
        "id": "line-10",
        "pace": 0.95,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "seed": 105,
        "speaker": "Frau Dorn",
        "style": "Sprich freundlich und alltagsnah, wie unter Nachbarn im Treppenhaus.",
