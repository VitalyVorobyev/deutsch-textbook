    "schema_version": 1,
    "script": [
      {
        "display_text": "Herr Nowak, erzählen Sie doch mal: Wo sind Sie aufgewachsen?",
        "id": "line-1",
        "pace": 0.79,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Reporterin",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Ich bin in einem Dorf in Polen aufgewachsen. Als Kind war ich fast immer draußen.",
        "id": "line-2",
        "pace": 0.88,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Herr Nowak",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Und was haben Sie nach der Schule gemacht?",
        "id": "line-3",
        "pace": 0.79,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Reporterin",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Zuerst wollte ich Lehrer werden. Aber ich hatte kein Geld für die Universität. Deshalb habe ich eine Ausbildung als Koch gemacht.",
        "id": "line-4",
        "pace": 0.88,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Herr Nowak",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Und seit wann sind Sie in Deutschland?",
        "id": "line-5",
        "pace": 0.79,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Reporterin",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Seit sechs Jahren. Vor sechs Jahren bin ich nach Hamburg gekommen, und heute habe ich ein kleines Restaurant.",
        "id": "line-6",
        "pace": 0.88,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Herr Nowak",
        "seed_override": null,
        "synthesis_text": null
      }
    ],
