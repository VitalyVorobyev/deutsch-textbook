        "display_text": "Guten Tag. Ich bin neu in der Stadt und möchte mich anmelden.",
        "id": "line-1",
        "pace": 0.74,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Herr Sanchez",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Gern. Haben Sie das Formular schon ausgefüllt?",
        "id": "line-2",
        "pace": 0.86,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Beamtin",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Ja, hier ist es. Meinen Pass habe ich auch dabei.",
        "id": "line-3",
        "pace": 0.74,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Herr Sanchez",
        "seed_override": null,
        "synthesis_text": null
      },
      {
