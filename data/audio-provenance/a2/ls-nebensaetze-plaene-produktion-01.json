    "schema_version": 1,
    "script": [
      {
        "display_text": "Am Sonntag fahren wir zum See. Kommst du mit, Yusuf?",
        "id": "line-1",
        "pace": 0.88,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Nina",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Ich würde gern mitkommen, aber ich kann nicht, weil ich am Sonntag arbeiten muss.",
        "id": "line-2",
        "pace": 0.74,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Yusuf",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Schade! Und wenn wir am Samstag fahren?",
        "id": "line-3",
        "pace": 0.88,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Nina",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Am Samstag habe ich Zeit. Aber ich glaube, dass es am Samstag regnet.",
        "id": "line-4",
        "pace": 0.74,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Yusuf",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Das Museum ist am Samstag leider geschlossen. Aber ich habe eine Idee: Wenn es regnet, gehen wir ins Kino.",
        "id": "line-5",
        "pace": 0.76,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Tobias",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Gute Idee! Und wenn die Sonne scheint, fahren wir zum See.",
        "id": "line-6",
        "pace": 0.88,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Nina",
        "seed_override": null,
        "synthesis_text": null
      }
    ],
