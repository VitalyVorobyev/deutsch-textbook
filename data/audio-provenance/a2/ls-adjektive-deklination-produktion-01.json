          "request": {
            "language": "German",
            "params": {},
            "seed": 120,
            "style": null,
            "text": "Ja, genau. Ich suche eine kleine Wohnung mit einem ruhigen Zimmer zum Arbeiten.",
            "voice": "ae5e135251bcb66bc00eacee8e9ebae19fdd33621795998402ce05f625fa8354"
          }
        },
        "type": "synth"
      },
      {
