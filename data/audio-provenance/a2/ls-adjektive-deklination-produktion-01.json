    "script": [
      {
        "display_text": "Guten Tag, Sie haben wegen der Wohnung angerufen?",
        "id": "line-1",
        "pace": 0.86,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Vermieterin",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Ja, genau. Ich suche eine kleine Wohnung mit einem ruhigen Zimmer zum Arbeiten.",
        "id": "line-2",
        "pace": 0.76,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Herr Adam",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Die Wohnung hat zwei Zimmer. Das größere Zimmer geht zur Straße, das kleinere zum Hof. Da ist es sehr ruhig.",
        "id": "line-3",
        "pace": 0.86,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Vermieterin",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Und die Küche? Ist sie neu?",
        "id": "line-4",
        "pace": 0.76,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Herr Adam",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Die Küche ist alt, aber der Herd ist neu. Wir haben letzten Monat einen neuen Herd gekauft.",
        "id": "line-5",
        "pace": 0.86,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Vermieterin",
