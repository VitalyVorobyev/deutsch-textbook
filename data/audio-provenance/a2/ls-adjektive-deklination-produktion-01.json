          "request": {
            "language": "German",
            "params": {},
            "seed": 200,
            "style": null,
            "text": "Die Wohnung hat zwei Zimmer. Das größere Zimmer geht zur Straße, das kleinere zum Hof. Da ist es sehr ruhig.",
            "voice": "6b8c22132a5e8e7c32ce1ebe37ed945982c6d378431442aaf1f78e0f788fbca7"
          }
        },
        "type": "synth"
