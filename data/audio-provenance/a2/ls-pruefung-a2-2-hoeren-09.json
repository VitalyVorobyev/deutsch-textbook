    "script": [
      {
        "display_text": "Und? Passt der Pullover?",
        "id": "line-1",
        "pace": 0.77,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Verkäufer",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Die Größe ist gut, und das Blau gefällt mir auch. Aber neunundachtzig Euro – das ist mir zu teuer.",
        "id": "line-2",
        "pace": 0.79,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Kundin",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Wir haben ihn auch in Grau, für neunundfünfzig Euro.",
        "id": "line-3",
        "pace": 0.77,
        "pause_after_ms": 450,
        "pronunciation_overrides": [],
        "role": "Verkäufer",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Grau steht mir nicht. Danke, ich schaue noch in einem anderen Geschäft.",
        "id": "line-4",
        "pace": 0.79,
        "pause_after_ms": 450,
