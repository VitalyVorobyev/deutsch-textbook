    "script": [
      {
        "display_text": "Hallo Anna, hier ist Tom. Vielen Dank für die Einladung! Ich freue mich sehr für dich.",
        "id": "line-1",
        "pace": 0.74,
        "pause_after_ms": 700,
        "pronunciation_overrides": [],
        "role": "Tom",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Aber leider kann ich am Samstag nicht kommen, weil ich arbeiten muss. Meine Schicht endet erst um zweiundzwanzig Uhr.",
        "id": "line-2",
        "pace": 0.74,
        "pause_after_ms": 700,
        "pronunciation_overrides": [],
        "role": "Tom",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Ich habe ein Geschenk für dich. Nina bringt dir das Geschenk mit. Es ist eine Überraschung!",
        "id": "line-3",
        "pace": 0.74,
        "pause_after_ms": 700,
        "pronunciation_overrides": [],
        "role": "Tom",
        "seed_override": null,
        "synthesis_text": null
      },
      {
        "display_text": "Am Sonntag habe ich Zeit. Trinken wir zusammen einen Kaffee? Herzlichen Glückwunsch zum Geburtstag!",
        "id": "line-4",
        "pace": 0.74,
        "pause_after_ms": 700,
        "pronunciation_overrides": [],
        "role": "Tom",
        "seed_override": null,
        "synthesis_text": null
      }
    ],
