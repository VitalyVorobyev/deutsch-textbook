{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["bun"],
    "paths": {
      "@lib/*": ["./src/lib/*"],
      "@components/*": ["./src/components/*"],
      "@da/schema": ["./packages/schema/src/index.ts"],
      "@da/schema/*": ["./packages/schema/src/*"],
      "@da/content/*": ["./packages/content/src/*"],
      "@da/grading/*": ["./packages/grading/src/*"],
      "@da/renderers/*": ["./packages/renderers/src/*"],
      "@da/ui/*": ["./packages/ui/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "packages/*/src/**/*",
    "apps/*/src/**/*",
    "apps/tonwerk/ui/src/**/*",
    "apps/*/plugin/**/*",
    "content/**/*",
    ".astro/types.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
