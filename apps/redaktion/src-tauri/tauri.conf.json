{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Redaktion",
  "version": "0.4.0",
  "identifier": "dev.nonvision.deutsch-atlas.redaktion",
  "build": {
    "beforeDevCommand": "bun run desktop:dev",
    "devUrl": "http://localhost:4330",
    "beforeBuildCommand": "bun run desktop:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Redaktion · Deutsch-Atlas",
      "width": 1440,
      "height": 920,
      "minWidth": 900,
      "minHeight": 640
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/redaktion-sidecar", "binaries/redaktion-validate"],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
