---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Bilingual from '../../components/Bilingual.astro';
import Chrome from '../../components/Chrome.astro';
import En from '../../components/En.astro';
import Ru from '../../components/Ru.astro';
import Uk from '../../components/Uk.astro';
import De from '../../components/De.astro';
import ExampleQuote from '../../components/ExampleQuote.astro';
import CaseTable from '../../components/reference/CaseTable.astro';
import PronominalAdverbTable from '../../components/reference/PronominalAdverbTable.astro';
import VocabTable from '../../components/VocabTable.astro';
import WordField from '../../components/vocab/WordField.astro';
import ExerciseSetIsland from '../../components/exercises/ExerciseSet';
import ReadingTextIsland from '../../components/reading/ReadingText';
import DueBadge from '../../components/srs/DueBadge';
import TopicProgress from '../../components/topic/TopicProgress';
import type { StringKey } from '../../lib/strings';
import { buildDeck, wordFieldContexts } from '../../lib/srs';
import SeeAlso from '../../components/topic/SeeAlso.astro';
import { getCurriculum } from '@da/content/curriculum';
import { focusIntroducedBy } from '@da/content/focus-tags';
import { topicPath, withBase } from '../../lib/url';

export async function getStaticPaths() {
  const articles = await getCollection('topics');
  // The route is still the article's path (`a2/perfekt-haben-sein`); everything the page renders
  // now comes from the sibling manifest, keyed by the id in that path.
  const byId = new Map(getCurriculum().nodes.map((node) => [node.id, node]));
  return articles.flatMap((entry) => {
    const manifest = byId.get(entry.id.split('/').at(-1)!);
    return manifest ? [{ params: { slug: entry.id }, props: { entry, manifest } }] : [];
  });
}

const { entry, manifest } = Astro.props;
const { Content } = await render(entry);
const data = { ...manifest, ...manifest.elements };
const wordFields = (await getCollection('wortfelder')).filter((field) => field.data.topic === data.id);
// Optional editorial pieces that name this topic. Reviewed only, so a draft is neither
// listed nor built — and the link is one-way: the topic never declares its pieces, so
// adding one changes nothing about the lesson. Reading it writes no attempt, card, readAt
// or mastery; it is an aside, not a step.
const discoveryPieces = (await getCollection('discovery', ({ data: d }) => d.status === 'reviewed'))
  .filter((piece) => piece.data.topics.includes(data.id));
const lexicalContexts = wordFieldContexts(wordFields.map((field) => field.data));

const { nodes } = getCurriculum();
const byId = new Map(nodes.map((t) => [t.id, t]));
const prerequisites = data.prerequisites
  .map((id) => byId.get(id))
  .filter((t) => t !== undefined);

const exerciseSets = await Promise.all(
  data.exercises.map(async (id) => {
    const set = await getEntry('exercises', id);
    if (!set) throw new Error(`Topic ${data.id}: exercise set "${id}" not found`);
    const document = set.data.stimulus ? await getEntry('documents', set.data.stimulus) : undefined;
    if (set.data.stimulus && !document)
      throw new Error(`Topic ${data.id}: document "${set.data.stimulus}" not found`);
    const itemDocumentIds = [...new Set(set.data.items.flatMap((item) => item.stimulus ? [item.stimulus] : []))];
    const itemDocuments = await Promise.all(itemDocumentIds.map(async (documentId) => {
      const itemDocument = await getEntry('documents', documentId);
      if (!itemDocument) throw new Error(`Topic ${data.id}: document "${documentId}" not found`);
      return [documentId, itemDocument.data] as const;
    }));
    return { id, data: set.data, document: document?.data, documents: Object.fromEntries(itemDocuments) };
  }),
);

const activityGroups = [
  { id: 'core', label: 'topic.activityCore', hint: 'topic.activityCoreHint' },
  { id: 'extension', label: 'topic.activityExtension', hint: 'topic.activityExtensionHint' },
  { id: 'application', label: 'topic.activityApplication', hint: 'topic.activityApplicationHint' },
  { id: 'remediation', label: 'topic.activityRemediation', hint: 'topic.activityRemediationHint' },
] as const satisfies { id: NonNullable<(typeof exerciseSets)[number]['data']['activity']>; label: StringKey; hint: StringKey }[];
const groupedExerciseSets = activityGroups
  .map((group) => ({ ...group, sets: exerciseSets.filter((set) => set.data.activity === group.id) }))
  .filter((group) => group.sets.length > 0);

const vocabFiles = await Promise.all(
  data.vocab.map(async (id) => {
    const v = await getEntry('vocab', id);
    if (!v) throw new Error(`Topic ${data.id}: vocab file "${id}" not found`);
    return v.data;
  }),
);

const readings = await Promise.all(
  data.reading.map(async (id) => {
    const r = await getEntry('reading', id);
    if (!r) throw new Error(`Topic ${data.id}: reading "${id}" not found`);
    return { id, data: r.data };
  }),
);

const pretestSet = data.pretest ? await getEntry('exercises', data.pretest) : undefined;

// --- "Siehe auch": every edge derived from data the curriculum owns (ADR 0007) ---
const introducedHere = Object.entries(focusIntroducedBy)
  .filter(([, owner]) => owner === data.id)
  .map(([tag]) => tag);

/** data id -> the page that projects it; presentation-only routing, no curriculum facts */
const REFERENZ_ROUTES: Record<string, { href: string; title: string }> = {
  cases: { href: '/referenz/kasus-praepositionen', title: 'Kasus & Präpositionen' },
  'pronominal-adverbs': { href: '/referenz/da-wo-woerter', title: 'Da- & Wo-Wörter' },
  'sentence-connectors': { href: '/referenz/satzverbindungen', title: 'Satzverbindungen' },
  'zahlen-datum-zeit': { href: '/referenz/zahlen-datum-zeit', title: 'Zahlen, Datum & Zeit' },
  briefe: { href: '/referenz/briefe', title: 'Briefe & Nachrichten' },
  zeitformen: { href: '/referenz/zeitformen', title: 'Zeitformen & Modus' },
};
const referenzLinks = (await getCollection('referenceData'))
  .filter((r) => {
    const keys =
      r.data.id === 'zeitformen'
        ? new Set(r.data.forms.flatMap((form) => form.focus))
        : new Set((r.data as { focus?: string[] }).focus ?? []);
    return introducedHere.some((tag) => keys.has(tag));
  })
  .map((r) => REFERENZ_ROUTES[r.data.id])
  .filter((route) => route !== undefined);

const toChip = (id: string) => {
  const t = byId.get(id);
  return t ? [{ id, title_de: t.title_de, level: t.level }] : [];
};
const deepensChips = manifest.deepens.flatMap(toChip);
const deepenedByChips = nodes.filter((n) => n.deepens.includes(data.id)).flatMap((n) => toChip(n.id));
// Tags this topic's own items drill but another topic introduces — the "builds on" edge.
const drilledElsewhere = [
  ...new Set(
    exerciseSets
      .flatMap((set) => set.data.items.flatMap((item) => (item.focus ? [item.focus] : [])))
      .map((tag) => focusIntroducedBy[tag])
      .filter((owner) => owner && owner !== data.id),
  ),
];
const buildsOnChips = drilledElsewhere.flatMap(toChip);
if (data.pretest && !pretestSet)
  throw new Error(`Topic ${data.id}: pretest set "${data.pretest}" not found`);

/** Topic-kind badge, keyed into the chrome strings table (replaced KIND_LABEL). */
const KIND_KEY: Record<string, StringKey> = {
  grammar: 'kind.grammar',
  'vocab-field': 'kind.vocabField',
  communication: 'kind.communication',
  phonetics: 'kind.phonetics',
};
---

<Base title={data.title_de}>
  <nav class="mb-4 text-sm text-stone-400">
    <a href={withBase('/topics')} class="hover:text-stone-600 dark:hover:text-stone-200"><Chrome k="nav.themen" /></a>
    <span> / {data.level}</span>
  </nav>

  <header class="mb-8">
    <div class="flex flex-wrap items-center gap-2 text-xs">
      <span class="rounded-full bg-amber-100 px-2.5 py-0.5 font-bold text-amber-800 dark:bg-amber-900 dark:text-amber-200">
        {data.level}
      </span>
      <span class="rounded-full bg-stone-200 px-2.5 py-0.5 font-medium text-stone-600 dark:bg-stone-700 dark:text-stone-300">
        <Chrome k={KIND_KEY[data.kind]} />
      </span>
      {data.status === 'draft' && (
        <span class="rounded-full border border-stone-300 px-2.5 py-0.5 text-stone-400 dark:border-stone-600">
          <Chrome k="topic.draft" />
        </span>
      )}
      <TopicProgress
        client:only="react"
        topicId={data.id}
        exerciseSets={data.exercises}
        vocabIds={data.vocab}
        readingIds={data.reading}
        pretestId={data.pretest}
      />
    </div>
    <h1 lang="de" class="mt-3 text-3xl font-bold tracking-tight">{data.title_de}</h1>
    <p class="mt-1 text-stone-500 dark:text-stone-400">
      <span class="lang-en">{data.title_en}</span>
      <span class="lang-ru">{data.title_ru}</span>
      {data.title_uk && <span class="lang-uk">{data.title_uk}</span>}
    </p>
    {
      prerequisites.length > 0 && (
        <p class="mt-3 text-sm text-stone-500 dark:text-stone-400">
          <Chrome k="topic.prerequisites" />
          {prerequisites.map((p) => (
            <a
              href={withBase(topicPath(p))}
              lang="de"
              class="ml-2 text-sky-700 hover:underline dark:text-sky-400"
            >
              {p.title_de}
            </a>
          ))}
        </p>
      )
    }
  </header>

  {
    data.pretest && pretestSet && (
      <aside class="mb-10 rounded-xl border-2 border-dashed border-amber-400 bg-amber-50/60 p-5 dark:border-amber-700 dark:bg-amber-950/40">
        <h2 class="text-lg font-bold"><Chrome k="topic.pretestTitle" /></h2>
        <p class="mt-1 mb-4 text-sm text-stone-600 dark:text-stone-400">
          <span class="lang-en">
            Try to answer before you read — guessing first, even wrongly, measurably improves what
            you remember from the article.
          </span>
          <span class="lang-ru">
            Попробуйте ответить до чтения: догадки заранее — даже неверные — заметно улучшают
            запоминание материала.
          </span>
          <span class="lang-uk">
            Спробуйте відповісти ще до читання: спроба вгадати наперед — навіть хибна — помітно
            покращує те, що ви запам'ятаєте зі статті.
          </span>
        </p>
        <ExerciseSetIsland client:only="react" setId={data.pretest} set={pretestSet.data} />
      </aside>
    )
  }

  <article class="article-prose">
    <Content components={{ Bilingual, En, Ru, Uk, De, CaseTable, PronominalAdverbTable, blockquote: ExampleQuote }} />
  </article>

  {
    readings.length > 0 && (
      <section class="mt-12">
        <h2 class="mb-4 text-2xl font-bold"><Chrome k="topic.sectionReading" /></h2>
        <div class="flex flex-col gap-6">
          {readings.map((r) => (
            <ReadingTextIsland client:only="react" readingId={r.id} reading={r.data} />
          ))}
        </div>
      </section>
    )
  }

  {
    wordFields.length > 0 && (
      <section class="mt-12">
        <h2 class="mb-4 text-2xl font-bold"><Chrome k="topic.sectionWordField" /></h2>
        <div class="space-y-5">{wordFields.map((field) => <WordField field={field.data} />)}</div>
      </section>
    )
  }

  {
    vocabFiles.length > 0 && (
      <section class="mt-12">
        <h2 class="mb-4 text-2xl font-bold"><Chrome k="topic.sectionVocab" /></h2>
        {vocabFiles.map((v) => (
          <div class="mb-8">
            <div class="mb-2 flex items-center gap-3">
              <h3 lang="de" class="text-lg font-semibold">{v.title_de}</h3>
              <DueBadge client:only="react" cards={buildDeck(v.id, v.entries, lexicalContexts)} />
              <a
                href={withBase(`/vocab/${v.id}`)}
                class="ml-auto text-sm font-medium text-amber-700 hover:underline dark:text-amber-400"
              >
                Karten lernen →
              </a>
            </div>
            <VocabTable entries={v.entries} />
          </div>
        ))}
      </section>
    )
  }

  {
    discoveryPieces.length > 0 && (
      <section class="mt-12">
        <h2 class="mb-1 text-2xl font-bold"><Chrome k="nav.entdecken" /></h2>
        <p class="mb-4 text-sm text-stone-500">
          <span class="lang-en">Optional reading around this topic. Nothing here is graded or due.</span>
          <span class="lang-ru">Необязательное чтение вокруг темы. Ничего из этого не оценивается и не попадает в повторения.</span>
          <span class="lang-uk">Необов'язкове читання навколо теми. Ніщо з цього не оцінюється й не потрапляє в повторення.</span>
        </p>
        <div class="grid gap-3 sm:grid-cols-2">
          {discoveryPieces.map((piece) => (
            <a
              href={withBase(`/entdecken/${piece.id}`)}
              class="rounded-xl border border-stone-200 p-4 hover:border-amber-500 dark:border-stone-700"
            >
              <span class="text-xs font-bold text-amber-700">{piece.data.level}</span>
              <h3 lang="de" class="mt-1 font-semibold">{piece.data.title_de}</h3>
              <p class="mt-1 text-sm text-stone-500">
                <span class="lang-en">{piece.data.summary.en}</span>
                <span class="lang-ru">{piece.data.summary.ru}</span>
                {piece.data.summary.uk && <span class="lang-uk">{piece.data.summary.uk}</span>}
                {piece.data.summary.de && <span class="lang-de">{piece.data.summary.de}</span>}
              </p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    exerciseSets.length > 0 && (
      <section class="mt-12">
        <h2 class="text-2xl font-bold"><Chrome k="topic.sectionExercises" /></h2>
        <p class="mt-1 mb-5 text-sm text-stone-500 dark:text-stone-400">
          <Chrome k="topic.activityIntro" />
        </p>
        <div class="flex flex-col gap-4">
          {groupedExerciseSets.map((group) =>
            group.id === 'core' ? (
              <section class="rounded-xl border border-amber-300 bg-amber-50/40 p-3 dark:border-amber-800 dark:bg-amber-950/20 sm:p-4">
                <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2 px-1">
                  <div>
                    <h3 class="font-semibold text-stone-900 dark:text-stone-100"><Chrome k={group.label} /></h3>
                    <p class="text-xs text-stone-500 dark:text-stone-400"><Chrome k={group.hint} /></p>
                  </div>
                  <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800 dark:bg-amber-900 dark:text-amber-200">
                    Nächster Schritt
                  </span>
                </div>
                <div class="flex flex-col gap-4">
                  {group.sets.map((s) => (
                    <ExerciseSetIsland client:only="react" setId={s.id} set={s.data} document={s.document} documents={s.documents} />
                  ))}
                </div>
              </section>
            ) : (
              <details class="group rounded-xl border border-stone-200 bg-stone-50/60 open:bg-white dark:border-stone-700 dark:bg-stone-900/40 dark:open:bg-stone-900">
                <summary class="flex min-h-14 cursor-pointer list-none items-center gap-3 px-4 py-3 marker:content-none">
                  <span class="text-stone-400 transition-transform group-open:rotate-90" aria-hidden="true">›</span>
                  <span class="min-w-0 flex-1">
                    <span class="block font-semibold text-stone-900 dark:text-stone-100"><Chrome k={group.label} /></span>
                    <span class="block text-xs text-stone-500 dark:text-stone-400"><Chrome k={group.hint} /></span>
                  </span>
                  <span class="rounded-full bg-stone-200 px-2 py-0.5 text-xs tabular-nums text-stone-600 dark:bg-stone-700 dark:text-stone-300">
                    {group.sets.length}
                  </span>
                </summary>
                <div class="flex flex-col gap-4 border-t border-stone-200 p-3 dark:border-stone-700 sm:p-4">
                  {group.sets.map((s) => (
                    <ExerciseSetIsland client:only="react" setId={s.id} set={s.data} document={s.document} documents={s.documents} />
                  ))}
                </div>
              </details>
            ),
          )}
        </div>
      </section>
    )
  }
  <SeeAlso referenz={referenzLinks} deepens={deepensChips} deepenedBy={deepenedByChips} buildsOn={buildsOnChips} />
</Base>
