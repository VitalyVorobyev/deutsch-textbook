---
import Base from '../../../layouts/Base.astro';
import Chrome from '../../../components/Chrome.astro';
import UebenNav from '../../../components/UebenNav.astro';
import PruefungCrumbs from '../../../components/PruefungCrumbs.astro';
import LidPractice from '../../../components/lid/LidPractice';
import LidSource from '../../../components/lid/LidSource.astro';
import { lessonScopes } from '../../../components/lid/shared';
import { getLidCatalogue } from '../../../lib/content';
import { t } from '../../../lib/strings';

const { source, bankVersion, entries, lessons } = getLidCatalogue();
---

<Base title={`${t('lid.practice', 'de')} · ${t('lid.title', 'de')}`}>
  <UebenNav active="pruefung" />
  <PruefungCrumbs trail={[{ href: '/pruefung/leben', k: 'lid.title' }, { k: 'lid.practice' }]} />
  <!-- The breadcrumb names the page; the H1 is for the accessibility tree. -->
  <h1 class="sr-only"><Chrome k="lid.practice" /></h1>
  <!-- `?lektion=<id>` narrows practice to one lesson; the island reads it, since the page is static. -->
  <LidPractice
    client:only="react"
    entries={entries}
    bankVersion={bankVersion}
    pdfUrl={source.pdfUrl}
    lessons={lessonScopes(lessons)}
  />
  <LidSource source={source} />
</Base>
