---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import UebenNav from '../../components/UebenNav.astro';
import ExerciseSetIsland from '../../components/exercises/ExerciseSet';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const sets = await getCollection('exercises', ({ data }) => data.role === 'exam-practice');
  const levels = [...new Set(sets.map((set) => set.id.split('/')[0]!))];
  return levels.map((level) => ({ params: { level }, props: { level } }));
}

const { level } = Astro.props as { level: string };
const allSets = await getCollection('exercises', ({ data }) => data.role === 'exam-practice');
const sets = allSets.filter((set) => set.id.startsWith(`${level}/`));
const allDocuments = await getCollection('documents');
const documentsById = new Map(allDocuments.map((document) => [document.id, document.data]));
const title = `Prüfungspraxis ${level.toUpperCase()}`;
---

<Base title={title}>
  <UebenNav active="pruefung" />
  <!-- The H1 adds the level to the tab's "Prüfung"; the page's description is the tab's tooltip
       (docs/overview.md, "Page chrome"). The unverified-practice note stays visible: it is the
       open-production invariant, said before the learner writes, not after. -->
  <header class="mb-6">
    <h1 lang="de" class="text-2xl font-bold sm:text-3xl">{title}</h1>
    <p class="mt-2 text-sm text-stone-500 dark:text-stone-400">
      <span class="lang-en">Open writing and speaking are saved as unverified practice. Compare your response with the model; they do not raise measured mastery.</span>
      <span class="lang-ru">Свободное письмо и говорение сохраняются как непроверенная практика. Сравнивайте ответ с образцом; эти задания не повышают измеренное освоение.</span>
      <span class="lang-uk">Вільне письмо й говоріння зберігаються як неперевірена практика. Порівнюйте відповідь зі зразком; ці завдання не підвищують виміряне опанування.</span>
    </p>
    {level === 'a1' && (
      <p class="mt-2 text-sm">
        <a href={withBase('/pruefung/goethe-a1')} class="font-semibold text-amber-700 hover:underline dark:text-amber-400">Prüfungssimulator →</a>
        <span class="ml-1 text-stone-500 dark:text-stone-400">
          <span class="lang-en">Timed runs of the official Goethe practice sets, when their materials are present on this device.</span>
          <span class="lang-ru">Прогон официальных комплектов Гёте на время — если их материалы есть на этом устройстве.</span>
          <span class="lang-uk">Проходження офіційних комплектів Ґете на час — якщо їхні матеріали є на цьому пристрої.</span>
        </span>
      </p>
    )}
  </header>
  <div class="space-y-8">
    {sets.map((entry) => {
      const ids = [...new Set(entry.data.items.flatMap((item) => item.stimulus ? [item.stimulus] : []))];
      const documents = Object.fromEntries(ids.flatMap((id) => {
        const document = documentsById.get(id);
        return document ? [[id, document]] : [];
      }));
      return <ExerciseSetIsland client:only="react" setId={entry.id} set={entry.data} documents={documents} />;
    })}
  </div>
</Base>
