---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import UebenNav from '../../components/UebenNav.astro';
import { GOETHE_EXAMS } from '../../lib/pruefung';
import { getLidCatalogue } from '../../lib/content';
import { stateName } from '../../components/lid/shared';
import { hintAttrs } from '../../lib/nav-hints';
import { withBase } from '../../lib/url';
import { t } from '../../lib/strings';
import { LID_EXAM } from '@da/schema/lid';

// The hub is the only map of Prüfung: one card per exam, and every page below it carries a
// breadcrumb back here instead of a further row of tabs.
const practiceLevels = new Set(
  (await getCollection('exercises', ({ data }) => data.role === 'exam-practice')).map((set) => set.id.split('/')[0]),
);
const { state, entries } = getLidCatalogue();
const card =
  'block rounded-lg border border-stone-200 bg-white p-5 hover:border-amber-500 dark:border-stone-700 dark:bg-stone-800 dark:hover:border-amber-500';
---

<Base title="Prüfung" description="Prüfungsvorbereitung: Goethe-Zertifikat A1, A2, B1 und Leben in Deutschland">
  <UebenNav active="pruefung" />
  <h1 class="sr-only">Prüfung</h1>

  <div class="grid gap-4 sm:grid-cols-2">
    {
      GOETHE_EXAMS.map((exam) => (
        <a href={withBase(`/pruefung/${exam.level}`)} class={card}>
          <span class="flex items-center gap-2">
            <span class="rounded bg-amber-100 px-1.5 py-0.5 text-xs font-bold text-amber-800 dark:bg-amber-900/50 dark:text-amber-300">
              {exam.level.toUpperCase()}
            </span>
            <span lang="de" class="font-semibold">{exam.title}</span>
          </span>
          {exam.subtitle && (
            <span lang="de" class="mt-0.5 block text-sm text-stone-500 dark:text-stone-400">
              {exam.subtitle}
            </span>
          )}
          <span lang="de" class="mt-3 block text-sm text-stone-600 dark:text-stone-300">
            Offizielle Übungssätze: <span data-official-count={exam.level}>…</span>
            {practiceLevels.has(exam.level) && <span class="block">Eigene Übungen im Prüfungsformat</span>}
          </span>
        </a>
      ))
    }
    <a href={withBase('/pruefung/leben')} class={card} {...hintAttrs('leben')}>
      <span class="flex items-center gap-2">
        <span class="rounded bg-sky-100 px-1.5 py-0.5 text-xs font-bold text-sky-800 dark:bg-sky-900/50 dark:text-sky-300">
          LiD
        </span>
        <span lang="de" class="font-semibold">{t('lid.title', 'de')}</span>
      </span>
      <span lang="de" class="mt-0.5 block text-sm text-stone-500 dark:text-stone-400">
        Einbürgerungstest · {stateName(state)}
      </span>
      <span lang="de" class="mt-3 block text-sm text-stone-600 dark:text-stone-300">
        {entries.length} Fragen · Prüfungssimulation: {LID_EXAM.questions} Fragen in {LID_EXAM.minutes} Minuten
      </span>
    </a>
  </div>
</Base>

<script>
  // How many official sets each level has on this device. A build without the materials
  // serves no manifest (ADR 0009), and that is the normal case: the card says "nicht auf
  // diesem Gerät" rather than a zero that looks like a gap in the course.
  import { EXAM_MANIFEST_URL, parseExamManifest } from '../../lib/exam-sim';
  import { withBase } from '../../lib/url';

  const slots = [...document.querySelectorAll<HTMLElement>('[data-official-count]')];
  const show = (count: (level: string) => number) => {
    for (const slot of slots) {
      const n = count(slot.dataset.officialCount ?? '');
      slot.textContent = n > 0 ? String(n) : 'nicht auf diesem Gerät';
    }
  };
  fetch(withBase(EXAM_MANIFEST_URL))
    .then((response) => (response.ok ? response.json() : null))
    .then((value: unknown) => {
      const manifest = parseExamManifest(value);
      show((level) => manifest?.sets.filter((set) => set.level === level).length ?? 0);
    })
    .catch(() => show(() => 0));
</script>
