---
import Base from '../../layouts/Base.astro';
import Chrome from '../../components/Chrome.astro';
import UebenNav from '../../components/UebenNav.astro';
import FlashcardSession from '../../components/srs/FlashcardSession';
import { getAllCards, getDeckLevels, getTopicNodes } from '../../lib/content';
import { getCurriculum } from '@da/content/curriculum';

const [cards, nodes, deckLevels] = await Promise.all([
  getAllCards(),
  getTopicNodes(),
  getDeckLevels(),
]);
const { spine } = getCurriculum();
---

<Base title="Wiederholen">
  <UebenNav active="wiederholen" />
  <!-- The active tab names the page, so the H1 is for the accessibility tree only, and the
       description is the tab's tooltip (docs/design.md, "Page chrome"). -->
  <h1 class="sr-only"><Chrome k="ueben.tabWiederholen" /></h1>
  <FlashcardSession client:only="react" cards={cards} newLimit={15} gate={{ spine, nodes, deckLevels }} />
</Base>
