---
import Base from '../../layouts/Base.astro';
import Chrome from '../../components/Chrome.astro';
import UebenNav from '../../components/UebenNav.astro';
import FlashcardSession from '../../components/srs/FlashcardSession';
import { getAllCards, getDeckLevels, getTopicNodes } from '../../lib/content';
import { getCurriculum } from '../../lib/curriculum';

const [cards, nodes, deckLevels] = await Promise.all([
  getAllCards(),
  getTopicNodes(),
  getDeckLevels(),
]);
const { spine } = getCurriculum();
---

<Base title="Wiederholen">
  <UebenNav active="wiederholen" />
  <!-- The active UebenNav tab already names the page on a phone — the H1 and the
       standing description below it just push the first card half a viewport down.
       sr-only keeps the H1 in the accessibility tree; the description, being purely
       redundant with the tab, is hidden outright. Both return unchanged at sm+. -->
  <h1 class="text-3xl font-bold tracking-tight sr-only sm:not-sr-only"><Chrome k="ueben.tabWiederholen" /></h1>
  <p class="hidden sm:block mt-1 text-stone-500 dark:text-stone-400">
    <span class="lang-en">Your daily review across all decks — due cards first, then a few new ones.</span>
    <span class="lang-ru">Ежедневное повторение по всем колодам — сначала карточки к повторению, затем немного новых.</span>
    <span class="lang-uk">Щоденне повторення за всіма колодами — спершу картки до повторення, потім кілька нових.</span>
  </p>

  <div class="mt-8">
    <FlashcardSession client:only="react" cards={cards} newLimit={15} gate={{ spine, nodes, deckLevels }} />
  </div>
</Base>
