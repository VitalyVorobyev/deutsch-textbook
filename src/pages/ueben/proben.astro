---
import Base from '../../layouts/Base.astro';
import Chrome from '../../components/Chrome.astro';
import { ProbeCatchUpIsland } from '../../components/session/CorpusIslands';
import { corpusUrl } from '../../lib/corpus-payload';

// The probes-only catch-up run ("Probe-Rückstand"). Reached from the Heute card that
// appears when more probes are due than one ordinary session serves. Deliberately
// contains nothing else — no review, no training — so every answer is a cold-start
// measurement of what survived the interval.
const setsUrl = await corpusUrl('sets');
---

<Base title="Probe-Rückstand" preload={[setsUrl]}>
  <h1 class="text-3xl font-bold tracking-tight"><Chrome k="probe.backlogTitle" /></h1>
  <p class="mt-1 text-stone-500 dark:text-stone-400">
    <span class="lang-en">
      A probes-only visit: up to twelve delayed checks, most overdue first — and nothing else.
      No practice comes before them, so every answer measures what actually survived the
      interval. Whatever is left stays due and comes back on the Heute page.
    </span>
    <span class="lang-ru">
      Визит только из отложенных проверок: до двенадцати за раз, сначала самые просроченные — и ничего
      больше. Перед ними нет никакой практики, поэтому каждый ответ показывает, что действительно
      сохранилось в памяти. Остальные проверки остаются в очереди и вернутся на странице «Heute».
    </span>
    <span class="lang-uk">
      Заняття лише з відкладених перевірок: до дванадцяти за раз, спершу найбільш прострочені — і
      нічого більше. Перед ними немає жодної практики, тому кожна відповідь показує, що справді
      збереглося за час перерви. Решта лишається в черзі й повертається на сторінці «Heute».
    </span>
  </p>

  <div class="mt-8">
    <ProbeCatchUpIsland client:only="react" setsUrl={setsUrl} />
  </div>
</Base>
