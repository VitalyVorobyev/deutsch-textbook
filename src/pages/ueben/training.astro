---
import Base from '../../layouts/Base.astro';
import Chrome from '../../components/Chrome.astro';
import UebenNav from '../../components/UebenNav.astro';
import { MixedTrainingIsland } from '../../components/session/CorpusIslands';
import { getTopicNodes } from '../../lib/content';
import { corpusUrl } from '../../lib/corpus-payload';
import { getCurriculum } from '@da/content/curriculum';

const [setsUrl, nodes] = await Promise.all([corpusUrl('sets'), getTopicNodes()]);
const { spine } = getCurriculum();
---

<Base title="Gemischtes Training" preload={[setsUrl]}>
  <UebenNav active="training" />
  <!-- The active tab names the page; the description is its tooltip (docs/design.md, "Page chrome"). -->
  <h1 class="sr-only"><Chrome k="training.pageTitle" /></h1>
  <MixedTrainingIsland client:only="react" setsUrl={setsUrl} spine={spine} nodes={nodes} resumeKey="mixed" />
</Base>
