---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Chrome from '../../components/Chrome.astro';
import UebenNav from '../../components/UebenNav.astro';
import MixedTraining from '../../components/training/MixedTraining';
import type { TrainingSet } from '../../components/training/MixedTraining';
import { getTopicNodes } from '../../lib/content';
import { getCurriculum } from '@da/content/curriculum';

const [nodes, exercises, documents] = await Promise.all([
  getTopicNodes(),
  getCollection('exercises'),
  getCollection('documents'),
]);
const { spine, nodes: manifests } = getCurriculum();
const topicById = new Map(manifests.map((t) => [t.id, t]));
const documentById = new Map(documents.map((document) => [document.id, document.data]));

const sets: TrainingSet[] = exercises.map((e) => {
  const topic = topicById.get(e.data.topic);
  if (!topic) {
    throw new Error(`Training: exercise set "${e.id}" references unknown topic "${e.data.topic}"`);
  }
  return {
    setId: e.id,
    topicId: topic.id,
    title_de: topic.title_de,
    level: topic.level,
    role: e.data.role,
    arming: e.data.arming,
    items: e.data.items,
    document: e.data.stimulus ? documentById.get(e.data.stimulus) : undefined,
  };
});
---

<Base title="Gemischtes Training">
  <UebenNav active="training" />
  <!-- The active tab names the page; the description is its tooltip (docs/design.md, "Page chrome"). -->
  <h1 class="sr-only"><Chrome k="training.pageTitle" /></h1>
  <MixedTraining client:only="react" sets={sets} spine={spine} nodes={nodes} resumeKey="mixed" />
</Base>
