---
/**
 * The whole catalogue on one static page, grouped by the course's modules and topics, with an
 * anchor per topic and per question so either can be linked. Server-rendered throughout: no
 * React island per row (CLAUDE.md runtime invariant). The official text is shown verbatim, the
 * options in source order a–d with the key marked (ADR 0021).
 */
import Base from '../../layouts/Base.astro';
import Chrome from '../../components/Chrome.astro';
import UebenNav from '../../components/UebenNav.astro';
import LidImages from '../../components/lid/LidImages.astro';
import LidSource from '../../components/lid/LidSource.astro';
import { LID_OPTION_ORDER, lidText, questionAnchor, questionLabel, topicAnchor } from '../../components/lid/shared';
import { getLidCatalogue } from '../../lib/content';
import { t } from '../../lib/strings';
import { withBase } from '../../lib/url';

const { source, modules, entries } = getLidCatalogue();
const byId = new Map(entries.map((entry) => [entry.question.id, entry]));
const topicsOf = (m: (typeof modules)[number]) =>
  m.topics.map((topic) => ({ ...topic, entries: topic.ids.map((id) => byId.get(id)!) }));
---

<Base title={`${t('lid.catalogue', 'de')} · ${t('lid.title', 'de')}`}>
  <UebenNav active="leben" />
  <nav class="mb-2 text-sm text-stone-400">
    <a href={withBase('/leben')} class="hover:text-stone-600 dark:hover:text-stone-200"><Chrome k="lid.title" /></a>
    <span> / <Chrome k="lid.catalogue" /></span>
  </nav>
  <h1 class="text-3xl font-bold tracking-tight"><Chrome k="lid.catalogue" /></h1>
  <p class="mt-1 text-stone-500 dark:text-stone-400">{lidText('lid.catalogueIntro', 'de', { n: entries.length })}</p>

  <nav aria-labelledby="lid-contents" class="mt-6 rounded-lg border border-stone-200 bg-white p-4 dark:border-stone-700 dark:bg-stone-800">
    <p id="lid-contents" class="text-xs font-semibold uppercase tracking-wide text-stone-500 dark:text-stone-400"><Chrome k="lid.contents" /></p>
    <ul class="mt-2 space-y-3 text-sm">
      {
        modules.map((m) => (
          <li>
            <span class="font-semibold">{m.title}</span>
            <ul class="mt-1 grid gap-x-6 sm:grid-cols-2">
              {m.topics.map((topic) => (
                <li>
                  <a href={`#${topicAnchor(topic.id)}`} class="inline-flex min-h-9 items-center text-amber-700 hover:underline dark:text-amber-400">
                    {topic.title}
                  </a>
                  <span class="text-stone-400"> ({topic.ids.length})</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    modules.map((m) => (
      <section class="mt-10">
        <h2 class="text-2xl font-bold">{m.title}</h2>
        {topicsOf(m).map((topic) => (
          <section id={topicAnchor(topic.id)} class="mt-6 scroll-mt-32">
            <h3 class="text-lg font-semibold">{topic.title}</h3>
            <ol class="mt-3 space-y-3">
              {topic.entries.map(({ question, note }) => (
                <li
                  id={questionAnchor(question.id)}
                  lang="de"
                  class="scroll-mt-32 rounded-lg border border-stone-200 bg-white p-4 dark:border-stone-700 dark:bg-stone-800"
                >
                  <a
                    href={`#${questionAnchor(question.id)}`}
                    class="text-xs font-medium uppercase tracking-wide text-stone-500 hover:underline dark:text-stone-400"
                  >
                    {questionLabel(question, 'de')}
                  </a>
                  <p class="mt-1 font-semibold leading-snug">{question.question}</p>
                  <LidImages question={question} pdfUrl={source.pdfUrl} />
                  <ol class="mt-3 space-y-1 text-sm">
                    {LID_OPTION_ORDER.map((key) => (
                      <li
                        class:list={[
                          'flex gap-2 rounded-md px-2 py-1',
                          key === question.solution
                            ? 'bg-green-50 font-medium text-green-900 dark:bg-green-950/40 dark:text-green-200'
                            : 'text-stone-600 dark:text-stone-300',
                        ]}
                      >
                        <span class="w-4 shrink-0 font-semibold text-stone-400">{key}</span>
                        <span class="min-w-0 flex-1">{question.answers[key]}</span>
                        {key === question.solution && (
                          <span class="shrink-0">
                            <span aria-hidden="true">✓</span>
                            <span class="sr-only">{t('lid.correctAnswer', 'de')}</span>
                          </span>
                        )}
                      </li>
                    ))}
                  </ol>
                  {note?.rationale_de && (
                    <p class="mt-3 text-sm">
                      <span class="font-semibold">{t('lid.explanation', 'de')}:</span> {note.rationale_de}
                      {note.source && (
                        <span class="text-stone-500 dark:text-stone-400">
                          {' '}
                          ({t('lid.source', 'de')}: {note.source})
                        </span>
                      )}
                    </p>
                  )}
                </li>
              ))}
            </ol>
          </section>
        ))}
      </section>
    ))
  }

  <LidSource source={source} />
</Base>
