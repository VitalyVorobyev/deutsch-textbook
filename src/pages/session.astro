---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import { SessionFlowIsland } from '../components/session/CorpusIslands';
import { getDeckLevels, getTopicNodes } from '../lib/content';
import { corpusUrl } from '../lib/corpus-payload';
import { getCurriculum } from '@da/content/curriculum';

const [cardsUrl, setsUrl, nodes, deckLevels] = await Promise.all([
  corpusUrl('cards'),
  corpusUrl('sets'),
  getTopicNodes(),
  getDeckLevels(),
]);
const { spine } = getCurriculum();
---

<Base title="Session" preload={[cardsUrl, setsUrl]}>
  <!-- The stepper names the three steps, and the Heute card that leads here says what they are. -->
  <h1 class="sr-only"><Chrome k="session.pageTitle" /></h1>
  <div>
    <SessionFlowIsland client:only="react" cardsUrl={cardsUrl} setsUrl={setsUrl} spine={spine} nodes={nodes} deckLevels={deckLevels} />
  </div>
</Base>
