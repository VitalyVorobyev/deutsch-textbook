---
/**
 * The account page: the local copy of the progress, the storage diagnostics and the cloud
 * account. It is also the OAuth callback landing (worker/auth/state.ts `safeReturnTo` falls back
 * to /konto, and a failed callback appends ?auth=<reason>) and the address the pairing copy tells
 * the learner to type. It is reached from the profile menu in the header, not from the nav.
 */
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import KontoPanel from '../components/account/KontoPanel';
---

<Base title="Konto">
  <h1 class="mb-6 text-2xl font-bold"><Chrome k="account.title" /></h1>
  <KontoPanel client:only="react" />
</Base>
