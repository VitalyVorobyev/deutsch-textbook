---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import { getCheckpoints } from '../lib/content';
import { getCurriculum } from '../lib/curriculum';
import { goetheCoverage, hasManifest, ukHalfCoverage } from '../lib/coverage';
import { grammarCoverage } from '../lib/grammar-coverage';
import { withBase } from '../lib/url';

const REPO = 'https://github.com/VitalyVorobyev/deutsch-textbook';

// Every figure on this page is measured from the content at build time. Nothing
// here is a hand-maintained claim that can quietly go stale.
const [topics, exercises, readings, vocab] = await Promise.all([
  getCollection('topics'),
  getCollection('exercises'),
  getCollection('reading'),
  getCollection('vocab'),
]);
const { units } = getCurriculum();
const coverage = goetheCoverage('A1');
// A level with no committed Wortliste manifest has no coverage figure, and must not
// invent one. A2 gets its sentence only once data/goethe-a2-wortliste.txt exists.
const coverageA2 = hasManifest('A2') ? goetheCoverage('A2') : null;
// B1 is part-authored, so its Wortliste figure is mostly inherited: it measures how
// much of the B1 list the A1/A2 decks already teach, which is a claim about the
// learner's lexis and never about B1 completeness. How far the *level* has come is
// the grammar figure below plus the unit count, both computed like everything else.
const coverageB1 = hasManifest('B1') ? goetheCoverage('B1') : null;
// The structural counterpart to the Wortliste figure, and it exists because the lexical
// one was carrying the whole claim: A2 was called content-complete for months on the
// strength of 100% vocabulary while six A2-standard structures were unwritten. Computed
// from the content at build time, like every other number on this page.
const grammarA1 = grammarCoverage('A1');
const grammarA2 = grammarCoverage('A2');
// The same instrument answers "how far is B1", which is the question the card below used
// to answer with a hand-written sentence — it claimed a ten-unit contract and one live
// unit long after the contract was amended and six more units had shipped.
const grammarB1 = grammarCoverage('B1');
// The Ukrainian-half figure, same earned-claims rule: measured from the content
// files at build time, never hand-written — and a shortfall would be stated as one.
// The paragraph below also says the half covers every file, which is a claim rather
// than a count: `tests/i18n-content.test.ts` holds it true with a corpus ratchet, so
// a new ru-bearing file without its uk half fails the gate instead of quietly making
// this page's prose wrong.
const ukCoverage = ukHalfCoverage();

const levels = ['A1', 'A2', 'B1'] as const;
const stats = levels.map((level) => ({
  level,
  units: units.filter((u) => u.level === level).length,
}));
const a1 = stats.find((s) => s.level === 'A1')!;
const a2 = stats.find((s) => s.level === 'A2')!;
const b1 = stats.find((s) => s.level === 'B1')!;
// The Wörter tile counts every level, like its three siblings. It was A1+A2 only, which
// silently dropped the B1 decks the moment they existed — a tile row where one number
// answers a different question from the other three is worse than no tile.
const totalWords = new Set(vocab.flatMap((deck) => deck.data.entries.map((e) => e.de))).size;
// Checkpoints are content, so the claims below are too: whether a level has one
// at all, and how big it is, are both read off the checkpoint sets.
const checkpoints = await getCheckpoints();
const checkpointA1 = checkpoints.find((c) => c.level === 'A1');
const checkpointA2 = checkpoints.find((c) => c.level === 'A2');

const principles = [
  {
    de: 'Aktives Abrufen',
    en: 'Retrieval, not re-reading. Every exercise makes you produce the answer — you type the German rather than pick it from a list wherever typing is possible. Pulling a word out of memory is what strengthens it; recognising it on a page barely does.',
    ru: 'Активное припоминание, а не перечитывание. Каждое упражнение требует произвести ответ: там, где это возможно, немецкое слово вы печатаете, а не выбираете из списка. Память укрепляет именно извлечение слова, а не его узнавание на странице.',
    uk: 'Активне пригадування, а не перечитування. Кожна вправа вимагає відтворити відповідь: там, де можна друкувати, ви друкуєте німецьке слово, а не обираєте його зі списку. Слово закріплюється саме тоді, коли ви видобуваєте його з пам’яті; упізнавання на сторінці дає майже нічого.',
  },
  {
    de: 'Verteiltes Wiederholen',
    en: 'Spacing over cramming. Flashcards are scheduled by FSRS, a modern spaced-repetition algorithm, so a word comes back close to the moment you would have forgotten it. For the same reason a topic only counts as mastered once your practice spans at least two different days.',
    ru: 'Интервальное повторение вместо зубрёжки. Карточки планирует FSRS — современный алгоритм интервальных повторений, — поэтому слово возвращается примерно тогда, когда вы уже готовы его забыть. По той же причине тема считается освоенной, только если практика заняла не менее двух разных дней.',
    uk: 'Розподілене повторення замість зубріння. Картки планує FSRS — сучасний алгоритм інтервальних повторень, — тож слово повертається приблизно тоді, коли ви вже були б готові його забути. З тієї самої причини тема вважається опанованою лише тоді, коли ваша практика охоплює щонайменше два різні дні.',
  },
  {
    de: 'Verschränktes Üben',
    en: 'Interleaving. Mixed training deliberately shuffles topics instead of drilling one to exhaustion — blocked practice feels smoother and teaches less, because it lets you apply a rule without first having to choose it.',
    ru: 'Чередование тем. Смешанная тренировка намеренно перемешивает темы вместо того, чтобы «добивать» одну: блочная практика ощущается легче, но учит меньше — она позволяет применить правило, не выбирая его.',
    uk: 'Чергування тем. Змішане тренування навмисно перемішує теми, замість того щоб доводити одну до виснаження: блокова практика відчувається легшою і вчить менше, бо дозволяє застосувати правило, не обираючи його спершу.',
  },
  {
    de: 'Erst raten, dann lernen',
    en: 'Guess first, then learn. Each topic opens with a short pretest you are expected to get wrong. Trying and failing before an explanation measurably improves what the explanation then sticks to — so a pretest is never scored against you.',
    ru: 'Сначала попытка, потом объяснение. Каждая тема начинается с короткого претеста, в котором ошибаться нормально. Неудачная попытка до объяснения заметно улучшает усвоение самого объяснения — поэтому претест никогда не идёт в зачёт.',
    uk: 'Спершу спроба, потім пояснення. Кожна тема починається з короткого претесту, у якому помилятися нормально. Спроба й невдача перед поясненням помітно покращують те, що з цього пояснення потім засвоюється, — тому претест ніколи не зараховується вам у мінус.',
  },
  {
    de: 'Erklärendes Feedback',
    en: 'A wrong answer teaches. Instead of a red cross, you get the rule you tripped over — in your explanation language, right where you tripped. Every error you make is also tagged with the confusion behind it, and those tags are what steer your future practice.',
    ru: 'Ошибка учит. Вместо красного крестика появляется правило, на котором вы споткнулись, — на вашем языке объяснений, прямо на месте ошибки. Каждая ошибка помечается стоящей за ней путаницей, и именно эти метки направляют вашу дальнейшую практику.',
    uk: 'Хибна відповідь учить. Замість червоного хрестика ви отримуєте правило, на якому спіткнулися, — вашою мовою пояснень, просто там, де це сталося. Кожна ваша помилка ще й позначається тією плутаниною, що стоїть за нею, і саме ці позначки скеровують вашу подальшу практику.',
  },
  {
    de: 'Verständlicher Input',
    en: 'Comprehensible input. Every topic carries a reading written at its own level, with the hard phrases glossed in place. Language is not only assembled from rules — a good deal of it is absorbed from text you can almost, but not quite, read effortlessly.',
    ru: 'Понятный ввод. У каждой темы есть текст для чтения, написанный на её уровне, со сносками к трудным местам. Язык не только собирается из правил — во многом он усваивается из текста, который вы почти, но не совсем, читаете без усилий.',
    uk: 'Зрозумілий вхідний матеріал. Кожна тема має текст для читання, написаний на її ж рівні, з поясненнями до складних місць просто в тексті. Мова не лише збирається з правил — чимала її частина засвоюється з тексту, який ви майже, але не зовсім, читаєте без зусиль.',
  },
  {
    de: 'Ehrliche Messung',
    en: 'Honest measurement. Free writing is saved as practice and never quietly counted as a correct answer, because nothing here can actually check it. Your mastery badge reflects what was really measured — you can tell the app you have learned something, and it will move you along without pretending that was evidence.',
    ru: 'Честное измерение. Свободное письмо сохраняется как практика и никогда не засчитывается как верный ответ: проверить его тут по-настоящему нечем. Значок освоения отражает только то, что действительно измерено. Вы можете отметить тему как выученную — приложение пойдёт дальше, но не станет выдавать это за доказательство.',
    uk: 'Чесне вимірювання. Вільне письмо зберігається як практика й ніколи потайки не зараховується як правильна відповідь: перевірити його тут насправді нічим. Значок опанування відображає лише те, що справді виміряно, — ви можете позначити тему як вивчену, і застосунок пропустить вас далі, не вдаючи, що це доказ.',
  },
  {
    de: 'Kein Spielkram',
    en: 'No gamification. No streak you must not break, no coins, no leaderboard, no notifications. The dashboard exists to show you where you actually stand, not to manufacture a reason to come back.',
    ru: 'Никакой геймификации. Ни серии, которую нельзя прервать, ни монет, ни таблиц лидеров, ни уведомлений. Панель прогресса нужна, чтобы показать реальное положение дел, а не чтобы придумать повод вернуться.',
    uk: 'Жодної гейміфікації. Ні серії, яку не можна перервати, ні монет, ні таблиць лідерів, ні сповіщень. Панель прогресу існує, щоб показати, де ви насправді перебуваєте, а не щоб вигадати привід повернутися.',
  },
];
---

<Base title="Über Deutsch-Atlas">
  <h1 class="text-3xl font-bold tracking-tight"><Chrome k="about.pageTitle" /></h1>
  <p class="mt-2 max-w-prose text-stone-500 dark:text-stone-400">
    <span class="lang-en">
      A free, local-first German course: a textbook, interactive exercises and spaced-repetition
      flashcards in one place. Every explanation is written from scratch in each explanation
      language rather than translated into it — while the German itself stays German.
    </span>
    <span class="lang-ru">
      Бесплатный курс немецкого, работающий локально: учебник, интерактивные упражнения и карточки
      с интервальным повторением в одном месте. Каждое объяснение написано заново на каждом языке
      объяснений, а не переведено на него, — а сам немецкий остаётся немецким.
    </span>
    <span class="lang-uk">
      Безкоштовний курс німецької, що працює локально: підручник, інтерактивні вправи та картки
      з інтервальним повторенням в одному місці. Кожне пояснення написане заново кожною мовою
      пояснень, а не перекладене нею, — а сам німецький текст залишається німецьким.
    </span>
  </p>
  <p class="mt-3 max-w-prose text-sm text-stone-500 dark:text-stone-400">
    <span class="lang-en">Deutsch-Atlas is made by Vitaly Vorobyev. AI systems assist with drafts and generated assets; the course is human-directed and edited.</span>
    <span class="lang-ru">Deutsch-Atlas создаёт Виталий Воробьёв. Системы ИИ помогают с черновиками и созданием материалов; направление курса и редактура остаются за человеком.</span>
    <span class="lang-uk">Deutsch-Atlas створює Віталій Воробйов. Системи ШІ допомагають із чернетками та створенням матеріалів; напрям курсу й редактура залишаються за людиною.</span>
  </p>

  <section class="mt-10">
    <h2 class="text-xl font-bold">
      <span class="lang-en">How this course teaches</span>
      <span class="lang-ru">Как устроено обучение</span>
      <span class="lang-uk">Як навчає цей курс</span>
    </h2>
    <p class="mt-2 max-w-prose text-sm text-stone-500 dark:text-stone-400">
      <span class="lang-en">
        The design follows what research on learning actually supports, not what feels productive.
        Several of these principles are deliberately uncomfortable: they make a session feel harder
        while making the results last longer.
      </span>
      <span class="lang-ru">
        В основе — то, что действительно подтверждается исследованиями об обучении, а не то, что
        просто кажется продуктивным. Некоторые из этих принципов намеренно неудобны: занятие
        становится труднее, зато результат держится дольше.
      </span>
      <span class="lang-uk">
        В основу покладено те, що справді підтверджують дослідження про навчання, а не те, що
        просто здається продуктивним. Кілька з цих принципів навмисно незручні: заняття від них
        відчувається важчим, зате результат тримається довше.
      </span>
    </p>

    <dl class="mt-6 grid gap-5 sm:grid-cols-2">
      {principles.map((p) => (
        <div class="rounded-lg border border-stone-200 bg-white p-5 dark:border-stone-700 dark:bg-stone-800">
          <dt lang="de" class="font-semibold">{p.de}</dt>
          <dd class="mt-2 text-sm text-stone-600 dark:text-stone-300">
            <span class="lang-en">{p.en}</span>
            <span class="lang-ru">{p.ru}</span>
            <span class="lang-uk">{p.uk}</span>
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="mt-12">
    <h2 class="text-xl font-bold">
      <span class="lang-en">How complete the course is</span>
      <span class="lang-ru">Насколько курс завершён</span>
      <span class="lang-uk">Наскільки курс завершений</span>
    </h2>
    <p class="mt-2 max-w-prose text-sm text-stone-500 dark:text-stone-400">
      <span class="lang-en">
        An honest answer, because a half-finished level is worse than a missing one — you would
        study it believing it covered the ground. These numbers are measured from the course
        content each time this page is built.
      </span>
      <span class="lang-ru">
        Честный ответ, потому что наполовину готовый уровень хуже отсутствующего: его проходят в
        уверенности, что материал охвачен. Все числа измеряются по содержанию курса при каждой
        сборке этой страницы.
      </span>
      <span class="lang-uk">
        Чесна відповідь, бо наполовину готовий рівень гірший за відсутній: його проходили б у
        впевненості, що матеріал охоплено. Усі ці числа вимірюються за вмістом курсу щоразу, коли
        збирається ця сторінка.
      </span>
    </p>

    <div class="mt-6 space-y-4">
      <article class="rounded-lg border-l-4 border-emerald-500 bg-emerald-50/60 p-5 dark:bg-emerald-950/25">
        <h3 class="font-bold">
          A1 — <span class="lang-en">complete</span><span class="lang-ru">завершён</span>
          <span class="lang-uk">завершений</span>
        </h3>
        <p class="mt-2 max-w-prose text-sm text-stone-700 dark:text-stone-300">
          <span class="lang-en">
            All {a1.units} units are authored, from Erste Schritte to Freizeit &amp; Können. Each one
            has a diagnostic pretest, a full article, a graded reading, exercises across several task
            types, and its own vocabulary. {coverage.cards + coverage.grammar} of the
            {' '}{coverage.total} headwords on the official Goethe-Institut A1 Wortliste are covered
            ({coverage.percent}%) — {coverage.cards} as flashcards and {coverage.grammar} taught as
            grammar rather than as vocabulary. All {grammarA1.total} grammar points the A1 standard
            expects are taught, {grammarA1.late} of them at A2 — a sequencing choice this course
            makes deliberately and does not hide. A cumulative
            {checkpointA1 && ` ${checkpointA1.items.length}-item`} A1 checkpoint measures the
            level end to end.
          </span>
          <span class="lang-ru">
            Написаны все юниты уровня — от «Erste Schritte» до «Freizeit &amp; Können», всего
            {' '}{a1.units}. В каждом
            есть диагностический претест, полная статья, текст для чтения, упражнения нескольких
            типов и собственный словарь. Из {coverage.total} слов официального списка Goethe-Institut
            A1 Wortliste охвачено {coverage.cards + coverage.grammar} ({coverage.percent}%):
            {' '}{coverage.cards} — карточками, ещё {coverage.grammar} даются как грамматика, а не как
            лексика. Охвачены все грамматические пункты стандарта A1 — всего {grammarA1.total};
            {' '}{grammarA1.late}
            из них даются на A2 — это осознанный выбор последовательности, и он не скрывается.
            Итоговая контрольная точка A1
            {checkpointA1 && ` из ${checkpointA1.items.length} заданий`} проверяет уровень
            целиком.
          </span>
          <span class="lang-uk">
            Написано всі юніти рівня — від «Erste Schritte» до «Freizeit &amp; Können», усього
            {' '}{a1.units}. У кожному є діагностичний претест, повна стаття, адаптований текст для
            читання, вправи кількох типів і власний словник. Із {coverage.total} слів офіційного
            списку Goethe-Institut A1 Wortliste охоплено {coverage.cards + coverage.grammar}
            ({coverage.percent}%): {coverage.cards} — картками, ще {coverage.grammar} подано як
            граматику, а не як лексику. Викладено всі граматичні пункти, яких очікує стандарт A1, —
            усього {grammarA1.total}; {grammarA1.late} з них подано на рівні A2: це свідомий вибір
            послідовності, і курс його не приховує.
            Підсумкова контрольна точка A1
            {checkpointA1 && ` з ${checkpointA1.items.length} завдань`} перевіряє рівень
            повністю.
          </span>
        </p>
      </article>

      <article class="rounded-lg border-l-4 border-emerald-500 bg-emerald-50/60 p-5 dark:bg-emerald-950/25">
        <h3 class="font-bold">
          A2 — <span class="lang-en">complete</span><span class="lang-ru">завершён</span>
          <span class="lang-uk">завершений</span>
        </h3>
        <p class="mt-2 max-w-prose text-sm text-stone-700 dark:text-stone-300">
          <span class="lang-en">
            All {a2.units} units are authored, from Dativ to Ämter &amp; Dienstleistungen. Each one has
            a diagnostic pretest, a full article, a graded reading, exercises across several task
            types including listening, writing and speaking, and a delayed probe that asks the same
            competence again weeks later.
            {coverageA2 &&
              ` ${coverageA2.cards + coverageA2.grammar} of the ${coverageA2.total} headwords on the
              official Goethe-Institut A2 Wortliste are covered (${coverageA2.percent}%) —
              ${coverageA2.cards} as flashcards and ${coverageA2.grammar} taught as grammar rather
              than as vocabulary.`}
            {` All ${grammarA2.total} grammar points the A2 standard expects are taught
              (${grammarA2.percent}%), each one measured by a practice or drill item that names the
              confusion it drills — testing a structure in a checkpoint does not count as teaching it.`}
            {checkpointA2 && ` A cumulative ${checkpointA2.items.length}-item A2 checkpoint measures
              the level end to end.`} What that does not mean is that finishing it makes you A2 —
            that is a claim about you, not about the content, and no course can make it for you.
          </span>
          <span class="lang-ru">
            Написаны все юниты уровня — от «Dativ» до «Ämter &amp; Dienstleistungen», всего
            {' '}{a2.units}. В каждом есть
            диагностический претест, полная статья, текст для чтения, упражнения нескольких типов —
            включая аудирование, письмо и говорение — и отложенная проверка, которая спрашивает то же
            умение снова спустя недели.
            {coverageA2 &&
              ` Из ${coverageA2.total} слов официального списка Goethe-Institut A2 Wortliste охвачено
              ${coverageA2.cards + coverageA2.grammar} (${coverageA2.percent}%): ${coverageA2.cards} —
              карточками, ещё ${coverageA2.grammar} даются как грамматика, а не как лексика.`}
            {` Охвачены все грамматические пункты стандарта A2 — всего ${grammarA2.total} (${grammarA2.percent}%),
              и каждый подтверждён упражнением, которое называет соответствующую трудность:
              проверить структуру в контрольной точке не значит её обучить.`}
            {checkpointA2 && ` Итоговая контрольная точка A2 из ${checkpointA2.items.length} заданий
              проверяет уровень целиком.`} Это не значит, что, пройдя курс, вы автоматически получите
            A2: это утверждение о вас, а не о содержании, и ни один курс не может сделать его за вас.
          </span>
          <span class="lang-uk">
            Написано всі юніти рівня — від «Dativ» до «Ämter &amp; Dienstleistungen», усього
            {' '}{a2.units}. У кожному є діагностичний претест, повна стаття, адаптований текст для
            читання, вправи кількох типів — зокрема аудіювання, письмо й говоріння — і відкладена
            перевірка, яка через тижні знову запитує те саме вміння.
            {coverageA2 &&
              ` Із ${coverageA2.total} слів офіційного списку Goethe-Institut A2 Wortliste охоплено
              ${coverageA2.cards + coverageA2.grammar} (${coverageA2.percent}%): ${coverageA2.cards} —
              картками, ще ${coverageA2.grammar} подано як граматику, а не як лексику.`}
            {` Викладено всі граматичні пункти, яких очікує стандарт A2, — усього ${grammarA2.total}
              (${grammarA2.percent}%), і кожен підтверджено вправою, яка називає відповідну
              трудність: перевірити структуру в контрольній точці не означає її навчити.`}
            {checkpointA2 && ` Підсумкова контрольна точка A2 з ${checkpointA2.items.length} завдань
              перевіряє рівень повністю.`} Але це не означає, що, пройшовши курс, ви автоматично
            маєте A2: це твердження про вас, а не про зміст, і жоден курс не може зробити його за вас.
          </span>
        </p>
      </article>

      <article class="rounded-lg border-l-4 border-stone-300 p-5 dark:border-stone-600">
        <h3 class="font-bold">
          B1 <span class="lang-en">— in progress</span
          ><span class="lang-ru">— в работе</span>
          <span class="lang-uk">— у роботі</span>
        </h3>
        <p class="mt-2 max-w-prose text-sm text-stone-600 dark:text-stone-400">
          <span class="lang-en">
            {b1.units} B1 units are live so far, each built like an A2 one — pretest, article,
            graded reading, exercises, delayed probe and its own vocabulary — and each also
            explained in German for learners who no longer need the detour through another
            language. {grammarB1.covered} of the {grammarB1.total} grammar points the B1 standard
            expects are taught ({grammarB1.percent}%), measured the same way as at A1 and A2: a
            point counts only where a practice or drill item names the confusion it drills. The
            long-term aim is B2, and the course is built so that levels can be added without
            disturbing what you have already learned.
            {coverageB1 &&
              ` ${coverageB1.cards + coverageB1.grammar} of the ${coverageB1.total} headwords on the
              official Goethe-Institut B1 Wortliste are covered so far (${coverageB1.percent}%) —
              most of it inherited from A1/A2 material, not progress on the level itself.`}
          </span>
          <span class="lang-ru">
            Пока доступно {b1.units} юнитов уровня B1. Каждый устроен так же, как юнит A2 —
            претест, статья, текст для чтения, упражнения, отложенная проверка и собственный
            словарь, — и вдобавок объясняется по-немецки: для тех, кому уже не нужен обходной путь
            через другой язык. Из {grammarB1.total} грамматических пунктов, которых ожидает
            стандарт B1, изложено {grammarB1.covered} ({grammarB1.percent}%); мерка та же, что на
            A1 и A2: пункт засчитывается, только если упражнение прямо называет соответствующую
            трудность. Долгосрочная цель — B2, и курс построен так, чтобы новые уровни добавлялись,
            не затрагивая уже пройденное.
            {coverageB1 &&
              ` Из ${coverageB1.total} слов официального списка Goethe-Institut B1 Wortliste пока
              охвачено ${coverageB1.cards + coverageB1.grammar} (${coverageB1.percent}%) — в
              основном унаследовано от материалов A1–A2, а не прогресс по самому уровню.`}
          </span>
          <span class="lang-uk">
            Наразі доступно {b1.units} юнітів рівня B1. Кожен побудовано так само, як юніт A2 —
            претест, стаття, адаптований текст для читання, вправи, відкладена перевірка і власний
            словник, — а ще кожен пояснено німецькою: для тих, кому вже не потрібен обхідний шлях
            через іншу мову. Із {grammarB1.total} граматичних пунктів, яких очікує стандарт B1,
            викладено {grammarB1.covered} ({grammarB1.percent}%); мірка та сама, що на A1 і A2:
            пункт зараховується лише тоді, коли вправа прямо називає відповідну трудність.
            Довгострокова мета — B2, і курс побудовано так, щоб нові рівні додавалися, не зачіпаючи
            того, що ви вже вивчили.
            {coverageB1 &&
              ` Із ${coverageB1.total} слів офіційного списку Goethe-Institut B1 Wortliste поки що
              охоплено ${coverageB1.cards + coverageB1.grammar} (${coverageB1.percent}%) — здебільшого
              це успадковано з матеріалів A1–A2, а не поступ на самому рівні.`}
          </span>
        </p>
      </article>
