---
import '../styles/global.css';
import ProfileSwitcher from '../components/ProfileSwitcher';
import FirstRunGate from '../components/FirstRunGate';
import UpdatePrompt from '../components/UpdatePrompt';
import PersistenceAlert from '../components/PersistenceAlert';
import { withBase } from '../lib/url';
import { t, type StringKey } from '../lib/strings';
import { hintAttrs, type HintKey } from '../lib/nav-hints';

interface Props {
  title: string;
  description?: string;
  /** Data files the page's island will fetch, requested while the HTML is still parsing. */
  preload?: string[];
}
const { title, description = 'Deutsch-Atlas — ein interaktives Lehrbuch', preload = [] } = Astro.props;

const home = withBase('/');
interface NavItem {
  href: string;
  /** Chrome-string key, rendered in German — the pinned chrome language. */
  label: StringKey;
  /** Extra path prefixes that also count as "this tab" (e.g. /vocab/<deck> → Üben). */
  match?: string[];
  /** The page's description, shown as the link's tooltip instead of under its H1. */
  hint?: HintKey;
}
const nav: NavItem[] = [
  { href: home, label: 'nav.heute' },
  { href: withBase('/topics'), label: 'nav.themen', hint: 'themen' },
  { href: withBase('/entdecken'), label: 'nav.entdecken', hint: 'entdecken' },
  { href: withBase('/referenz'), label: 'nav.referenz', hint: 'referenz' },
  { href: withBase('/ueben'), label: 'nav.ueben', match: [withBase('/vocab'), withBase('/pruefung'), withBase('/leben')] },
  { href: withBase('/progress'), label: 'nav.fortschritt', hint: 'fortschritt' },
  { href: withBase('/about'), label: 'nav.ueber' },
];
const current = Astro.url.pathname;
function isActive(item: NavItem): boolean {
  if (item.href === home) return current === home || current === home.replace(/\/$/, '');
  return [item.href, ...(item.match ?? [])].some((prefix) => current.startsWith(prefix));
}
const activeItem = nav.find(isActive);
---

<!doctype html>
<html lang="en" data-explain-lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover lets the standalone PWA paint under the notch; the
         header and footer pay it back with env(safe-area-inset-*) padding. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={withBase('/favicon.png')} />
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={withBase('/icons/apple-touch-icon.png')} />
    <meta name="theme-color" content="#d97706" />
    <!-- iOS reads its own key rather than the manifest's display mode. -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Deutsch-Atlas" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <title>{title} · Deutsch-Atlas</title>
    <script is:inline>
      (function () {
        let theme = localStorage.getItem('da:theme');
        if (!theme) theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        // The learning language is profile-scoped; this mirrors
        // resolveExplainLang in src/lib/prefs.ts (keep in sync) because a
        // pre-paint script cannot import. Profile resolution mirrors
        // getActiveProfileId in src/lib/profile.ts: da:profile, else first
        // registered, else 'local'. The chrome language is pinned German —
        // no ui-lang attribute to stamp (resolveUiLang has the rationale).
        let pid = localStorage.getItem('da:profile');
        if (!pid) {
          try {
            const list = JSON.parse(localStorage.getItem('da:profiles') || 'null');
            if (Array.isArray(list) && list[0] && typeof list[0].id === 'string') pid = list[0].id;
          } catch {
            /* unreadable registry — fall through to the anonymous id */
          }
        }
        if (!pid) pid = 'local';
        // Own-key check mirrors isExplainLang: the four-value EXPLAIN_LANGS set.
        let lang = localStorage.getItem('da:lang:' + pid);
        if (lang !== 'en' && lang !== 'ru' && lang !== 'uk' && lang !== 'de') {
          // First read for this profile: copy the legacy device-level choice
          // forward, but leave da:lang in place as the device default that the
          // next new profile inherits. The legacy key predates uk/de and is
          // never written anymore, so it deliberately stays en/ru-only.
          const legacy = localStorage.getItem('da:lang');
          if (legacy === 'ru' || legacy === 'en') {
            lang = legacy;
            localStorage.setItem('da:lang:' + pid, legacy);
          }
        }
        if (lang === 'en' || lang === 'ru' || lang === 'uk' || lang === 'de')
          document.documentElement.dataset.explainLang = lang;
        // Running as an installed app — the Tauri desktop shell, or the PWA in its own window —
        // so the footer's "App installieren" would offer what the learner is already using.
        if (
          '__TAURI_INTERNALS__' in window ||
          matchMedia('(display-mode: standalone)').matches ||
          navigator.standalone === true
        )
          document.documentElement.dataset.installed = '';
      })();
    </script>
    {preload.map((href) => <link rel="preload" href={href} as="fetch" crossorigin="anonymous" />)}
  </head>
  <body class="flex min-h-screen flex-col">
    <FirstRunGate client:only="react" />
    <UpdatePrompt client:only="react" />
    <PersistenceAlert client:only="react" />
    <header class="sticky top-0 z-10 border-b border-stone-200 bg-stone-50/90 pt-[env(safe-area-inset-top)] backdrop-blur dark:border-stone-700 dark:bg-stone-900/90">
      {/* One row at every width: a sticky header that wraps costs that row on every screen of
          every page (it was 103 px on a phone, 83 px at 700 px). `relative` anchors the phone
          menu's panel to the full header width rather than to its button. */}
      <div class="relative mx-auto flex max-w-4xl items-center gap-x-3 px-4 py-1.5 md:gap-x-4 md:py-3">
        <a href={home} class="shrink-0 text-base font-bold tracking-tight text-stone-900 sm:text-lg dark:text-stone-100">
          Deutsch-<span class="text-amber-600 dark:text-amber-400">Atlas</span>
        </a>
        {/* ≥768px: the flat link row. Each link's tooltip is its page's description. */}
        <nav aria-label="Hauptnavigation" class="hidden gap-x-4 text-sm md:flex">
          {
            nav.map((item) => (
              <a
                href={item.href}
                {...hintAttrs(item.hint)}
                class:list={[
                  'py-1 font-medium whitespace-nowrap',
                  isActive(item)
                    ? 'text-amber-700 dark:text-amber-400'
                    : 'text-stone-600 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100',
                ]}
              >
                {t(item.label, 'de')}
              </a>
            ))
          }
        </nav>
        {/* <768px: a disclosure in the brand row, named after the current section — so a page
            needs no visible H1 to say where the learner is. All links at equal weight in a panel
            that overlays the page rather than growing the sticky header. Works without
            JS; the dismiss script at the end of <body> only adds outside-tap/Escape. */}
        <details id="nav-menu" class="group min-w-0 md:hidden">
          <summary
            class="flex min-h-11 cursor-pointer list-none items-center gap-1.5 rounded-md border border-stone-300 px-3 text-sm font-medium text-stone-700 [&::-webkit-details-marker]:hidden dark:border-stone-600 dark:text-stone-200"
          >
            <span class="truncate">{t(activeItem?.label ?? 'nav.menu', 'de')}</span>
            <span aria-hidden="true" class="text-xs text-stone-400 transition-transform group-open:rotate-90">▸</span>
          </summary>
          <nav
            aria-label="Hauptnavigation"
            class="absolute inset-x-4 top-full z-20 mt-1 grid grid-cols-2 gap-1 rounded-md border border-stone-200 bg-stone-50 p-2 shadow-lg dark:border-stone-700 dark:bg-stone-900"
          >
            {
              nav.map((item) => (
                <a
                  href={item.href}
                  class:list={[
                    'flex min-h-11 items-center rounded px-3 text-sm font-medium',
                    isActive(item)
                      ? 'bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-400'
                      : 'text-stone-600 hover:bg-stone-100 dark:text-stone-400 dark:hover:bg-stone-800',
                  ]}
                >
                  {t(item.label, 'de')}
                </a>
              ))
            }
          </nav>
        </details>
        <div class="ml-auto flex shrink-0 items-center gap-2">
          <ProfileSwitcher client:only="react" />
          <button
            type="button"
            id="theme-toggle"
            class="rounded-md border border-stone-300 px-2.5 py-1.5 text-xs dark:border-stone-600 sm:px-2 sm:py-1"
            aria-label="Toggle dark mode"
          >
            <span class="dark:hidden">🌙</span><span class="hidden dark:inline">☀️</span>
          </button>
        </div>
      </div>
    </header>

    <main class="mx-auto w-full max-w-4xl flex-1 px-4 py-5 sm:py-8">
      <slot />
    </main>

    <footer class="border-t border-stone-200 py-6 pb-[calc(1.5rem+env(safe-area-inset-bottom))] text-center text-xs text-stone-500 dark:border-stone-700 dark:text-stone-400">
      {t('footer.tagline', 'de')}
      <a href={withBase('/install')} class="install-link ml-2 underline decoration-dotted hover:text-stone-700 dark:hover:text-stone-200">App installieren</a>
    </footer>

    <script>
      import { setTheme } from '../lib/prefs';
      import { applyHints } from '../lib/nav-hints';

      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        setTheme(next);
      });

      // Navigation tooltips follow Lernsprache, including a switch made without a reload.
      applyHints(document, document.documentElement.dataset.explainLang);
      window.addEventListener('da:langchange', (e) => {
        applyHints(document, (e as CustomEvent<string>).detail);
      });
    </script>
    <script is:inline>
      // Nav-disclosure dismiss: outside-tap (mousedown, matching
      // ProfileSwitcher) and Escape. <details> handles open/close natively.
      (function () {
        const menu = document.getElementById('nav-menu');
        if (!menu) return;
        document.addEventListener('mousedown', (e) => {
          if (menu.open && e.target instanceof Node && !menu.contains(e.target)) menu.open = false;
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && menu.open) {
            menu.open = false;
            menu.querySelector('summary')?.focus();
          }
        });
      })();
    </script>
  </body>
</html>
