---
/**
 * The page-level Referenz→topic edge: "the atlas teaches this here", as chips.
 *
 * Same derivation as TenseSystem's per-form chips (the ADR 0007 reference
 * implementation): the reference data names focus tags only, `focusIntroducedBy`
 * turns them into topics at build time, so a renamed topic or a re-homed tag can
 * never leave a stale link — the page rebuilds to the new truth or the validator
 * fails on the unknown tag.
 */
import { getCollection, getEntry } from 'astro:content';
import { focusIntroducedBy } from '../../lib/focus-tags';
import { topicPath, withBase } from '../../lib/url';

interface Props {
  /** reference-data id whose page-level `focus` list this row renders */
  source: string;
}
const { source } = Astro.props;

const entry = await getEntry('referenceData', source);
const focus: string[] = (entry?.data as { focus?: string[] } | undefined)?.focus ?? [];

const topics = new Map((await getCollection('topics')).map((t) => [t.data.id, t.data]));

const LEVEL_ORDER = ['A1', 'A2', 'B1', 'B2'];
const taughtIn = [...new Set(focus.map((tag) => focusIntroducedBy[tag]).filter(Boolean))]
  .map((id) => topics.get(id!))
  .filter((topic) => topic !== undefined)
  .sort((a, b) => LEVEL_ORDER.indexOf(a.level) - LEVEL_ORDER.indexOf(b.level));
---

{taughtIn.length > 0 && (
  <p class="mt-3 flex flex-wrap items-center gap-1.5 text-sm">
    <span class="mr-1 text-stone-500">
      <span class="lang-en">Taught in:</span>
      <span class="lang-ru">Это учат здесь:</span>
      <span class="lang-uk">Це вчать тут:</span>
    </span>
    {taughtIn.map((topic) => (
      <a
        href={withBase(topicPath(topic))}
        class="rounded border border-stone-200 px-2 py-0.5 text-xs text-stone-600 hover:border-amber-500 hover:text-amber-700 dark:border-stone-600 dark:text-stone-300 dark:hover:text-amber-400"
      >
        <span lang="de">{topic.title_de}</span>
        <span class="ml-1 opacity-60">{topic.level}</span>
      </a>
    ))}
  </p>
)}
