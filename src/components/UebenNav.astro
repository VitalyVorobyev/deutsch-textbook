---
/**
 * Sub-navigation for the Üben tab: Wiederholen | Training | Wortschatz | Prüfung.
 * Server-rendered links; the owning page declares which tab is active. Every exam — the Goethe
 * levels and Leben in Deutschland — lives under Prüfung, whose hub (/pruefung) and breadcrumbs
 * (`PruefungCrumbs.astro`) do the rest, so this row never grows past four.
 * Four tabs fit a 320 px phone without scrolling: below `sm` they share the row as equal columns,
 * from `sm` up they sit at their natural width.
 * Each tab carries its page's description as a tooltip (`src/lib/nav-hints.ts`): the pages show
 * no H1 or description of their own, because the active tab already names them.
 */
import Chrome from './Chrome.astro';
import { withBase } from '../lib/url';
import { hintAttrs } from '../lib/nav-hints';

interface Props {
  active: 'wiederholen' | 'training' | 'wortschatz' | 'pruefung';
}
const { active } = Astro.props;

const tabs = [
  { id: 'wiederholen', href: withBase('/ueben/wiederholen'), label: 'ueben.tabWiederholen' },
  { id: 'training', href: withBase('/ueben/training'), label: 'ueben.tabTraining' },
  { id: 'wortschatz', href: withBase('/ueben/wortschatz'), label: 'ueben.tabWortschatz' },
  { id: 'pruefung', href: withBase('/pruefung'), label: 'ueben.tabPruefung' },
] as const;
---

<nav
  aria-label="Üben"
  class="mb-6 grid grid-cols-4 border-b border-stone-200 text-[13px] sm:flex sm:gap-x-5 sm:text-sm dark:border-stone-700"
>
  {
    tabs.map((tab) => (
      <a
        href={tab.href}
        {...hintAttrs(tab.id)}
        aria-current={tab.id === active ? 'page' : undefined}
        class:list={[
          '-mb-px border-b-2 py-2 text-center font-medium whitespace-nowrap sm:text-left',
          tab.id === active
            ? 'border-amber-600 text-amber-700 dark:border-amber-400 dark:text-amber-400'
            : 'border-transparent text-stone-600 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100',
        ]}
      >
        <Chrome k={tab.label} />
      </a>
    ))
  }
</nav>
