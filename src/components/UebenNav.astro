---
/**
 * Sub-navigation for the merged Üben tab: Wiederholen | Training | Wortschatz | Prüfung | Leben in D.
 * Server-rendered links; the owning page declares which tab is active. The Leben-in-Deutschland
 * trainer is a sub-tab rather than a top-level one (backlog P25-8: exam training is training).
 * The row scrolls inside itself when five tabs outgrow a phone (`overflow-x-auto`).
 * Each tab carries its page's description as a tooltip (`src/lib/nav-hints.ts`): the pages show
 * no H1 or description of their own, because the active tab already names them.
 */
import Chrome from './Chrome.astro';
import { withBase } from '../lib/url';
import { hintAttrs } from '../lib/nav-hints';

interface Props {
  active: 'wiederholen' | 'training' | 'wortschatz' | 'pruefung' | 'leben';
}
const { active } = Astro.props;

const tabs = [
  { id: 'wiederholen', href: withBase('/ueben/wiederholen'), label: 'ueben.tabWiederholen' },
  { id: 'training', href: withBase('/ueben/training'), label: 'ueben.tabTraining' },
  { id: 'wortschatz', href: withBase('/ueben/wortschatz'), label: 'ueben.tabWortschatz' },
  { id: 'pruefung', href: withBase('/pruefung/a1'), label: 'ueben.tabPruefung' },
  { id: 'leben', href: withBase('/leben'), label: 'ueben.tabLeben' },
] as const;
---

<nav
  aria-label="Üben"
  class="mb-6 flex gap-x-5 overflow-x-auto whitespace-nowrap border-b border-stone-200 text-sm dark:border-stone-700"
>
  {
    tabs.map((tab) => (
      <a
        href={tab.href}
        {...hintAttrs(tab.id)}
        aria-current={tab.id === active ? 'page' : undefined}
        class:list={[
          '-mb-px border-b-2 py-2 font-medium',
          tab.id === active
            ? 'border-amber-600 text-amber-700 dark:border-amber-400 dark:text-amber-400'
            : 'border-transparent text-stone-600 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100',
        ]}
      >
        <Chrome k={tab.label} />
      </a>
    ))
  }
</nav>
<script is:inline>
  // Five tabs outgrow a phone and the row scrolls inside itself — so the active tab, last of
  // all on /leben, would load clipped off the edge. Scroll it into view before first paint, and
  // once more on `load` for when the stylesheet arrived after this ran (the dev server injects
  // CSS from JS). Idempotent: a tab already in view measures no overshoot.
  (function () {
    const nav = document.currentScript && document.currentScript.previousElementSibling;
    const active = nav && nav.querySelector('[aria-current="page"]');
    if (!active) return;
    const reveal = () => {
      const overshoot = active.getBoundingClientRect().right - nav.getBoundingClientRect().right;
      if (overshoot > 0) nav.scrollLeft += overshoot + 16;
    };
    reveal();
    window.addEventListener('load', reveal, { once: true });
  })();
</script>
