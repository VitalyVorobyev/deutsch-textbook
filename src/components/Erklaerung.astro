---
/**
 * A German-first article's explanation in the learner's own language (ADR 0023), collapsed after
 * the section's <Translation>. Unlike the translation it was written for its reader from the start
 * — an English false friend, a Russian case contrast — so it may say more than the German does,
 * and it is kept whole rather than cut down to a translation. It shows the half of the learner's
 * Lernsprache (`.lang-*`, global.css); under `de` global.css hides it with the translation.
 */
import Chrome from './Chrome.astro';
---

<details class="erklaerung-fold mb-6 rounded-md border border-stone-200 dark:border-stone-700">
  <summary class="cursor-pointer select-none px-3 py-1.5 text-sm font-medium text-stone-500 hover:text-stone-800 dark:text-stone-400 dark:hover:text-stone-200">
    <Chrome k="fold.erklaerung" />
  </summary>
  <div class="border-t border-stone-200 px-3 text-[0.95em] text-stone-700 dark:border-stone-700 dark:text-stone-300">
    <slot />
  </div>
</details>
