---
/**
 * A lesson section's translation, collapsed (ADR 0021). The German above it is the lesson — the
 * exam is in German, so it stays the text the learner reads — and this opens on demand when a
 * paragraph does not land, showing the half of the learner's Lernsprache (`.lang-*`, global.css).
 * Under `de` there is nothing to translate into, and global.css hides the whole block.
 *
 * Holds an <En>, a <Ru> and, once the lesson carries Ukrainian, a <Uk> half — the validator's
 * rule (`lidLessonBodyProblems`), one block at the end of every section that has German text.
 *
 * `open` is for `## Kurz gesagt` alone (validator-enforced): the summary is read in both languages
 * at once — German, then the learner's own — so it starts expanded, while every later section
 * translates on demand. It can still be collapsed.
 */
import Chrome from '../Chrome.astro';

interface Props {
  open?: boolean;
}
const { open = false } = Astro.props;
---

<details open={open} class="lid-translation mb-6 rounded-md border border-stone-200 dark:border-stone-700">
  <summary class="cursor-pointer select-none px-3 py-1.5 text-sm font-medium text-stone-500 hover:text-stone-800 dark:text-stone-400 dark:hover:text-stone-200">
    <Chrome k="lid.lessonTranslation" />
  </summary>
  <div class="border-t border-stone-200 px-3 text-[0.95em] text-stone-700 dark:border-stone-700 dark:text-stone-300">
    <slot />
  </div>
</details>
