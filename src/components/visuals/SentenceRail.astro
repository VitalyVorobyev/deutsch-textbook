---
import LearningFigure from './LearningFigure.astro';

type View = 'v2' | 'separable' | 'modal' | 'perfekt' | 'subordinate' | 'indirect' | 'zu';

interface Props {
  view: View;
}

const { view } = Astro.props;

/**
 * A cell is its text and its role. `finite` is the conjugated verb, `close` the part of the verb
 * that ends the clause, `signal` the word that sends the verb to the end, `gap` the slot the verb
 * has left. Inside a text, *…* marks the conjugated verb where it shares a cell.
 */
type Role = 'plain' | 'finite' | 'close' | 'signal' | 'gap';
type Cell = [text: string, role?: Role];

interface Figure {
  title: string;
  /** one label per column; '' leaves the column unnamed */
  columns: string[];
  /** every row fills the same columns, so the same slot sits under the same label */
  rows: { label?: string; cells: Cell[] }[];
  /** draws the bracket from the conjugated verb to the clause-final part */
  bracket?: boolean;
  caption: string;
  en: string;
  ru: string;
  uk: string;
}

const figures: Record<View, Figure> = {
  v2: {
    title: 'Das Verb bleibt auf Position 2',
    columns: ['Position 1', 'Position 2', '', ''],
    rows: [
      { cells: [['Nina'], ['arbeitet', 'finite'], ['heute'], ['im Büro.']] },
      { cells: [['Heute'], ['arbeitet', 'finite'], ['Nina'], ['im Büro.']] },
      { cells: [['Im Büro'], ['arbeitet', 'finite'], ['Nina'], ['heute.']] },
    ],
    caption:
      'Auf Position 1 steht jedes Mal etwas anderes. Das konjugierte Verb bleibt auf Position 2, und das Subjekt steht dann direkt nach dem Verb.',
    en: 'Three versions of one sentence stand one below the other, in the same columns. The first column changes from row to row: Nina, then Heute, then Im Büro. The second column is the same in all three rows: the conjugated verb arbeitet. When Nina is not in the first column, she stands in the third, right after the verb.',
    ru: 'Три варианта одного предложения стоят друг под другом в одних и тех же колонках. Первая колонка меняется от строки к строке: Nina, затем Heute, затем Im Büro. Вторая колонка во всех трёх строках одна и та же — спрягаемый глагол arbeitet. Когда Nina не стоит в первой колонке, она оказывается в третьей, сразу после глагола.',
    uk: 'Три варіанти одного речення стоять одне під одним у тих самих колонках. Перша колонка змінюється від рядка до рядка: Nina, потім Heute, потім Im Büro. Друга колонка в усіх трьох рядках та сама — відмінюване дієслово arbeitet. Коли Nina не стоїть у першій колонці, вона опиняється в третій, одразу після дієслова.',
  },
  separable: {
    title: 'anrufen: ruft … an',
    columns: ['', 'Position 2', '', 'Satzende'],
    bracket: true,
    rows: [
      { cells: [['Nina'], ['ruft', 'finite'], [''], ['an.', 'close']] },
      { cells: [['Nina'], ['ruft', 'finite'], ['ihre Mutter'], ['an.', 'close']] },
      { cells: [['Nina'], ['ruft', 'finite'], ['heute Abend ihre Mutter'], ['an.', 'close']] },
    ],
    caption:
      'Das Verb teilt sich: Der konjugierte Teil steht auf Position 2, die Vorsilbe am Satzende. Alles andere steht dazwischen – egal, wie lang der Satz wird.',
    en: 'Three sentences with anrufen stand one below the other, in the same columns. In every row ruft is in the second column and the prefix an in the last one; a bracket joins the two. Only the space between them grows: nothing, then ihre Mutter, then heute Abend ihre Mutter.',
    ru: 'Три предложения с anrufen стоят друг под другом в одних и тех же колонках. В каждой строке ruft стоит во второй колонке, а приставка an — в последней; их соединяет скобка. Растёт только середина: сначала она пустая, потом в ней ihre Mutter, потом heute Abend ihre Mutter.',
    uk: 'Три речення з anrufen стоять одне під одним у тих самих колонках. У кожному рядку ruft стоїть у другій колонці, а префікс an — в останній; їх з’єднує дужка. Росте лише середина: спершу вона порожня, потім у ній ihre Mutter, потім heute Abend ihre Mutter.',
  },
  modal: {
    title: 'Modalverb und Infinitiv bilden eine Klammer',
    columns: ['', 'Position 2', '', 'Satzende'],
    bracket: true,
    rows: [
      { cells: [['Nina'], ['muss', 'finite'], [''], ['arbeiten.', 'close']] },
      { cells: [['Nina'], ['muss', 'finite'], ['am Samstag'], ['arbeiten.', 'close']] },
      { cells: [['Am Samstag'], ['muss', 'finite'], ['Nina im Büro'], ['arbeiten.', 'close']] },
    ],
    caption:
      'Das Modalverb ist konjugiert und steht auf Position 2. Der Infinitiv steht am Satzende. Alles andere steht dazwischen.',
    en: 'Three sentences stand one below the other, in the same columns. In every row the conjugated modal muss is in the second column and the infinitive arbeiten in the last one; a bracket joins the two. The rest of the sentence sits between them, and in the third row Am Samstag has moved to the front without changing either verb position.',
    ru: 'Три предложения стоят друг под другом в одних и тех же колонках. В каждой строке спрягаемый модальный глагол muss стоит во второй колонке, а инфинитив arbeiten — в последней; их соединяет скобка. Остальные слова помещаются между ними, а в третьей строке Am Samstag вынесено в начало — и оба глагола остались на своих местах.',
    uk: 'Три речення стоять одне під одним у тих самих колонках. У кожному рядку відмінюване модальне дієслово muss стоїть у другій колонці, а інфінітив arbeiten — в останній; їх з’єднує дужка. Решта слів уміщується між ними, а в третьому рядку Am Samstag винесено на початок — і обидва дієслова лишилися на своїх місцях.',
  },
  perfekt: {
    title: 'Hilfsverb und Partizip bilden eine Klammer',
    columns: ['', 'Position 2', '', 'Satzende'],
    bracket: true,
    rows: [
      { cells: [['Nina'], ['hat', 'finite'], ['den Schrank'], ['aufgebaut.', 'close']] },
      { cells: [['Nina'], ['hat', 'finite'], ['gestern den Schrank'], ['aufgebaut.', 'close']] },
      { cells: [['Gestern'], ['hat', 'finite'], ['Nina den Schrank'], ['aufgebaut.', 'close']] },
    ],
    caption:
      'Das Hilfsverb ist konjugiert und steht auf Position 2. Das Partizip II steht am Satzende. Alles andere steht dazwischen.',
    en: 'Three sentences stand one below the other, in the same columns. In every row the auxiliary hat is in the second column and the participle aufgebaut in the last one; a bracket joins the two. The rest of the sentence sits between them, and in the third row Gestern has moved to the front without changing either verb position.',
    ru: 'Три предложения стоят друг под другом в одних и тех же колонках. В каждой строке вспомогательный глагол hat стоит во второй колонке, а причастие aufgebaut — в последней; их соединяет скобка. Остальные слова помещаются между ними, а в третьей строке Gestern вынесено в начало — и обе части сказуемого остались на своих местах.',
    uk: 'Три речення стоять одне під одним у тих самих колонках. У кожному рядку допоміжне дієслово hat стоїть у другій колонці, а дієприкметник aufgebaut — в останній; їх з’єднує дужка. Решта слів уміщується між ними, а в третьому рядку Gestern винесено на початок — і обидві частини присудка лишилися на своїх місцях.',
  },
  subordinate: {
    title: 'Im Nebensatz geht das Verb ans Ende',
    columns: ['', '', 'Position 2', '', 'Satzende'],
    rows: [
      {
        label: 'Hauptsatz',
        cells: [[''], ['Nina'], ['muss', 'finite'], ['am Samstag'], ['arbeiten.']],
      },
      {
        label: 'Nebensatz',
        cells: [['…, weil', 'signal'], ['Nina'], ['', 'gap'], ['am Samstag'], ['arbeiten *muss*.']],
      },
    ],
    caption:
      'Nach weil ist der Platz auf Position 2 leer: Das konjugierte Verb steht ganz am Ende, hinter dem Infinitiv.',
    en: 'The same sentence stands twice, in the same columns. As a main clause, the conjugated verb muss is in the Position 2 column. As a weil clause, that slot is empty and drawn with a dashed outline; muss now stands in the last column, after arbeiten. Everything else has kept its place.',
    ru: 'Одно и то же предложение стоит дважды в одних и тех же колонках. В главном предложении спрягаемый глагол muss стоит в колонке «Position 2». В придаточном с weil это место пустое и обведено пунктиром, а muss стоит в последней колонке, после arbeiten. Все остальные слова остались на своих местах.',
    uk: 'Те саме речення стоїть двічі в тих самих колонках. У головному реченні відмінюване дієслово muss стоїть у колонці «Position 2». У підрядному з weil це місце порожнє й обведене пунктиром, а muss стоїть в останній колонці, після arbeiten. Усі інші слова лишилися на своїх місцях.',
  },
  indirect: {
    title: 'Die Frage wird zum Nebensatz',
    columns: ['', 'Fragewort', 'Position 2', '', 'Satzende'],
    rows: [
      {
        label: 'Direkte Frage',
        cells: [[''], ['Wann', 'signal'], ['beginnt', 'finite'], ['der Kurs?'], ['']],
      },
      {
        label: 'Indirekte Frage',
        cells: [['Weißt du,'], ['wann', 'signal'], ['', 'gap'], ['der Kurs'], ['beginnt?', 'finite']],
      },
    ],
    caption:
      'Das Fragewort bleibt am Anfang der Frage. Das konjugierte Verb verlässt Position 2 und steht am Ende.',
    en: 'The same question stands twice, in the same columns. Asked directly, the conjugated verb beginnt follows the question word wann in the Position 2 column. After Weißt du, the question word is still first, the verb slot is empty and drawn with a dashed outline, and beginnt stands in the last column.',
    ru: 'Один и тот же вопрос стоит дважды в одних и тех же колонках. В прямом вопросе спрягаемый глагол beginnt идёт сразу за вопросительным словом wann, в колонке «Position 2». После Weißt du вопросительное слово по-прежнему первое, место глагола пустое и обведено пунктиром, а beginnt стоит в последней колонке.',
    uk: 'Те саме питання стоїть двічі в тих самих колонках. У прямому питанні відмінюване дієслово beginnt іде одразу за питальним словом wann, у колонці «Position 2». Після Weißt du питальне слово так само перше, місце дієслова порожнє й обведене пунктиром, а beginnt стоїть в останній колонці.',
  },
  zu: {
    title: 'Der zu-Infinitiv steht am Ende',
    columns: ['', 'Position 2', '', 'Satzende'],
    rows: [
      { cells: [['Nina'], ['versucht,', 'finite'], ['früher'], ['*zu* kommen.', 'close']] },
      { cells: [['Nina'], ['versucht,', 'finite'], ['früher'], ['auf*zu*stehen.', 'close']] },
    ],
    caption:
      'Der Infinitiv mit zu steht am Satzende. Bei einem trennbaren Verb steht zu zwischen Vorsilbe und Stamm: auf + zu + stehen.',
    en: 'Two sentences stand one below the other, in the same columns. In both, the conjugated verb versucht is in the second column and the infinitive with zu in the last one. With kommen, zu is a separate word in front of the infinitive. With the separable verb aufstehen, zu is written inside the word, between auf and stehen.',
    ru: 'Два предложения стоят друг под другом в одних и тех же колонках. В обоих спрягаемый глагол versucht стоит во второй колонке, а инфинитив с zu — в последней. С kommen частица zu пишется отдельным словом перед инфинитивом. С отделяемым глаголом aufstehen она пишется внутри слова, между auf и stehen.',
    uk: 'Два речення стоять одне під одним у тих самих колонках. В обох відмінюване дієслово versucht стоїть у другій колонці, а інфінітив із zu — в останній. З kommen частка zu пишеться окремим словом перед інфінітивом. З відокремлюваним дієсловом aufstehen вона пишеться всередині слова, між auf і stehen.',
  },
};

const figure = figures[view];
const width = figure.columns.length;
/** the column of the conjugated verb, and of the part that closes the clause, counted from 1 */
const from = figure.columns.indexOf('Position 2') + 1;
/** grid rows are explicit: 1 the column labels, 2 the bracket, then a label line and a line of cells per row */
const lines = figure.rows.map((_, index) => ({ label: 3 + index * 2, cells: 4 + index * 2 }));
const parts = (text: string) =>
  text.split('*').map((part, index) => ({ part, marked: index % 2 === 1 }));
---

<LearningFigure id={`sentence-rail-${view}`} title={figure.title} sourceClass="simulated">
  <div slot="visual" class="rail-scroll px-2 py-5 sm:px-5" aria-hidden="true">
    <div class="rail" style={`--columns: ${width}`}>
      {figure.columns.map((label, index) => (
        <span class="rail-head" style={`grid-column: ${index + 1}`}>{label}</span>
      ))}
      {figure.bracket && (
        <span class="rail-bracket" style={`grid-column: ${from} / ${width + 1}`}>
          <i>Satzklammer</i>
        </span>
      )}
      {figure.rows.map((row, line) => (
        <>
          {row.label && (
            <span class="rail-label" style={`grid-row: ${lines[line]!.label}`}>{row.label}</span>
          )}
          {row.cells.map(([text, role = 'plain'], index) => (
            <span
              class:list={['rail-cell', `rail-cell--${role}`, !text && role !== 'gap' && 'rail-cell--empty']}
              style={`grid-column: ${index + 1}; grid-row: ${lines[line]!.cells}`}
              lang="de"
            >
              <span>{parts(text).map(({ part, marked }) => (marked ? <b>{part}</b> : part))}</span>
            </span>
          ))}
        </>
      ))}
    </div>
  </div>

  <p slot="caption" lang="de">{figure.caption}</p>

  <div slot="description">
    <p class="lang-en">{figure.en}</p>
    <p class="lang-ru">{figure.ru}</p>
    <p class="lang-uk">{figure.uk}</p>
  </div>
</LearningFigure>

<style>
  /* One grid for all rows: a slot is a column, so the eye compares the rows downwards. The verb
     columns are the only coloured ones. */
  .rail-scroll {
    overflow-x: auto;
  }

  .rail {
    --finite: #b45309;
    --finite-bg: #fff7ed;
    --close: #0369a1;
    --close-bg: #f0f9ff;
    --line: #d6d3d1;
    --cell: #fff;
    --ink: #292524;
    --muted: #78716c;
    display: grid;
    grid-template-columns: repeat(var(--columns), auto);
    justify-content: center;
    gap: 0 0.2rem;
    color: var(--ink);
    font-size: clamp(0.75rem, 3.6vw, 1rem);
  }

  .rail-head {
    grid-row: 1;
    align-self: end;
    color: var(--muted);
    font-size: clamp(0.5rem, 2.5vw, 0.62rem);
    font-weight: 800;
    letter-spacing: 0.03em;
    text-align: center;
    text-transform: uppercase;
  }

  .rail-bracket {
    grid-row: 2;
    height: 0.9rem;
    margin: 0.6rem 1.1rem 0;
    border: 2px solid var(--muted);
    border-bottom: 0;
    border-radius: 0.4rem 0.4rem 0 0;
    text-align: center;
  }

  .rail-bracket i {
    position: relative;
    top: -0.7rem;
    background: var(--bg, #f5f5f4);
    padding: 0 0.4rem;
    color: var(--muted);
    font-size: 0.62rem;
    font-style: normal;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .rail-label {
    grid-column: 1 / -1;
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .rail-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.4rem;
    margin-top: 0.35rem;
    border: 1.5px solid var(--line);
    border-radius: 0.5rem;
    background: var(--cell);
    padding: 0.3rem clamp(0.25rem, 1.6vw, 0.6rem);
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    white-space: pre-wrap;
  }

  .rail-cell--empty {
    border-color: transparent;
    background: transparent;
  }

  .rail-cell--gap {
    min-width: 2.4rem;
    border-style: dashed;
    border-color: var(--finite);
    background: transparent;
  }

  .rail-cell--finite {
    border-color: var(--finite);
    background: var(--finite-bg);
    color: var(--finite);
    font-weight: 800;
  }

  .rail-cell--close {
    border-color: var(--close);
    background: var(--close-bg);
    color: var(--close);
    font-weight: 800;
  }

  .rail-cell--signal {
    border-color: var(--ink);
    font-weight: 800;
  }

  .rail-cell b {
    color: var(--finite);
    font-weight: 800;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  :global([data-theme='dark']) .rail {
    --finite: #fbbf24;
    --finite-bg: rgb(120 53 15 / 35%);
    --close: #7dd3fc;
    --close-bg: rgb(12 74 110 / 35%);
    --line: #57534e;
    --cell: #292524;
    --ink: #f5f5f4;
    --muted: #a8a29e;
    --bg: #0c0a09;
  }
</style>
