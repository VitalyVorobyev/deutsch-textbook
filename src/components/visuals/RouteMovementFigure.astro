---
import LearningFigure from './LearningFigure.astro';

interface Props {
  view: 'street' | 'train';
}

const { view } = Astro.props;
---

{
  view === 'street' ? (
    <LearningFigure id="route-second-street" title="Die zweite Straße rechts" sourceClass="simulated">
      <div slot="visual" class="route-layout px-3 py-5 sm:px-6" aria-hidden="true">
        <div class="route-map">
          <svg viewBox="0 0 420 360" role="presentation">
            <rect width="420" height="360" rx="20" fill="#e7e5e4" />
            <rect x="22" y="22" width="114" height="80" rx="10" fill="#d6d3d1" />
            <rect x="284" y="22" width="114" height="80" rx="10" fill="#d6d3d1" />
            <rect x="22" y="142" width="114" height="80" rx="10" fill="#d6d3d1" />
            <rect x="284" y="142" width="114" height="80" rx="10" fill="#d6d3d1" />
            <rect x="22" y="262" width="114" height="76" rx="10" fill="#d6d3d1" />
            <rect x="284" y="262" width="114" height="76" rx="10" fill="#d6d3d1" />
            <path d="M210 330 L210 120 L350 120" fill="none" stroke="#b45309" stroke-width="15" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M210 330 L210 120 L350 120" fill="none" stroke="#fbbf24" stroke-width="5" stroke-dasharray="12 11" stroke-linecap="round" />
            <path d="M210 170 L210 140" stroke="#7c2d12" stroke-width="6" stroke-linecap="round" />
            <path d="M210 140 L198 153 M210 140 L222 153" stroke="#7c2d12" stroke-width="6" stroke-linecap="round" />
            <path d="M302 120 L330 120" stroke="#7c2d12" stroke-width="6" stroke-linecap="round" />
            <path d="M330 120 L316 108 M330 120 L316 132" stroke="#7c2d12" stroke-width="6" stroke-linecap="round" />
            <circle cx="210" cy="320" r="18" fill="#075985" />
            <circle cx="210" cy="320" r="7" fill="#fff" />
            <path d="M350 94 h42 v52 h-42 z" fill="#fff" stroke="#075985" stroke-width="4" />
            <path d="M356 112 h30 M356 125 h22" stroke="#075985" stroke-width="4" />
            <circle cx="162" cy="240" r="15" fill="#fff" stroke="#57534e" stroke-width="3" />
            <text x="162" y="246" text-anchor="middle" font-size="17" font-weight="800" fill="#292524">1</text>
            <circle cx="162" cy="120" r="15" fill="#fff" stroke="#57534e" stroke-width="3" />
            <text x="162" y="126" text-anchor="middle" font-size="17" font-weight="800" fill="#292524">2</text>
          </svg>
          <span class="map-label map-label--start">Start</span>
          <span class="map-label map-label--post">die Post</span>
        </div>
        <ol class="route-steps">
          <li><span>1</span><strong>Gehen Sie geradeaus.</strong></li>
          <li><span>2</span><strong>Nehmen Sie die zweite Straße rechts.</strong></li>
          <li><span>3</span><strong>Die Post ist auf der rechten Seite.</strong></li>
        </ol>
      </div>

      <p slot="caption" lang="de">
        Die Straßen werden aus Ihrer Laufrichtung gezählt: an der ersten vorbei, an der zweiten
        nach rechts.
      </p>
      <div slot="description">
        <p class="lang-en">A person starts at the bottom and walks straight ahead. The first cross street is marked 1 and is passed. At cross street 2, the route turns right and ends at the post office on the right-hand side. Left and right are read from the walker’s direction.</p>
        <p class="lang-ru">Пешеход начинает внизу и идёт прямо. Первый перекрёсток отмечен цифрой 1: его нужно пройти. На втором перекрёстке маршрут поворачивает направо и заканчивается у почты с правой стороны. Лево и право определяются по направлению движения.</p>
        <p class="lang-uk">Пішохід починає внизу й іде прямо. Перше перехрестя позначене цифрою 1: його треба пройти. На другому перехресті маршрут повертає праворуч і закінчується біля пошти з правого боку. Ліворуч і праворуч визначаються за напрямком руху.</p>
      </div>
    </LearningFigure>
  ) : (
    <LearningFigure id="route-train-frames" title="mit dem Zug · in den Zug · im Zug" sourceClass="simulated">
      <div slot="visual" class="train-grid px-3 py-5 sm:px-6" aria-hidden="true">
        <section class="movement-card movement-card--means">
          <header><small>Womit?</small><strong>mit dem Zug</strong></header>
          <svg viewBox="0 0 240 150" role="presentation">
            <rect x="28" y="48" width="184" height="62" rx="16" fill="#e7e5e4" stroke="#57534e" stroke-width="4" />
            <rect x="48" y="62" width="42" height="28" rx="4" fill="#bae6fd" />
            <rect x="100" y="62" width="42" height="28" rx="4" fill="#bae6fd" />
            <rect x="152" y="62" width="38" height="28" rx="4" fill="#bae6fd" />
            <circle cx="70" cy="116" r="12" fill="#292524" />
            <circle cx="170" cy="116" r="12" fill="#292524" />
            <path d="M35 135 H205" stroke="#78716c" stroke-width="5" stroke-linecap="round" />
          </svg>
          <p>So reise ich.</p>
        </section>
        <section class="movement-card movement-card--action">
          <header><small>Wohin? · Akkusativ</small><strong>in den Zug</strong></header>
          <svg viewBox="0 0 240 150" role="presentation">
            <rect x="116" y="28" width="94" height="104" rx="12" fill="#e7e5e4" stroke="#57534e" stroke-width="4" />
            <rect x="136" y="47" width="48" height="76" rx="5" fill="#fff" stroke="#57534e" stroke-width="3" />
            <circle cx="55" cy="76" r="15" fill="#075985" />
            <path d="M55 92 V124 M35 108 L55 96 L75 108 M55 124 L42 142 M55 124 L69 142" stroke="#075985" stroke-width="7" stroke-linecap="round" />
            <path d="M78 82 H126" stroke="#b45309" stroke-width="8" stroke-linecap="round" />
            <path d="M126 82 L110 68 M126 82 L110 96" stroke="#b45309" stroke-width="8" stroke-linecap="round" />
          </svg>
          <p>Ich steige ein.</p>
        </section>
        <section class="movement-card movement-card--state">
          <header><small>Wo? · Dativ</small><strong>im Zug</strong></header>
          <svg viewBox="0 0 240 150" role="presentation">
            <rect x="22" y="24" width="196" height="112" rx="14" fill="#e7e5e4" stroke="#57534e" stroke-width="4" />
            <rect x="42" y="42" width="62" height="42" rx="5" fill="#bae6fd" stroke="#57534e" stroke-width="3" />
            <rect x="136" y="42" width="62" height="42" rx="5" fill="#bae6fd" stroke="#57534e" stroke-width="3" />
            <path d="M62 119 H105 V92 H62 Z M135 119 H178 V92 H135 Z" fill="#a8a29e" />
            <circle cx="120" cy="71" r="14" fill="#075985" />
            <path d="M120 87 V112 M105 100 H135" stroke="#075985" stroke-width="7" stroke-linecap="round" />
          </svg>
          <p>Ich sitze schon drinnen.</p>
        </section>
      </div>

      <p slot="caption" lang="de">
        <strong>mit</strong> nennt das Verkehrsmittel; <strong>in den</strong> zeigt die Bewegung
        hinein; <strong>im</strong> beschreibt den Ort nach der Bewegung.
      </p>
      <div slot="description">
        <p class="lang-en">Three cards separate three meanings. mit dem Zug names the means of travel. in den Zug shows a person moving through the train door and therefore uses accusative. im Zug shows the person already seated inside and therefore uses dative.</p>
        <p class="lang-ru">Три карточки разделяют три значения. mit dem Zug называет вид транспорта. in den Zug показывает движение человека через дверь внутрь поезда и поэтому требует Akkusativ. im Zug показывает человека уже внутри, в сидячем положении, и поэтому требует Dativ.</p>
        <p class="lang-uk">Три картки розділяють три значення. mit dem Zug називає вид транспорту. in den Zug показує рух людини через двері всередину потяга й тому вимагає Akkusativ. im Zug показує людину вже всередині, у сидячому положенні, й тому вимагає Dativ.</p>
      </div>
    </LearningFigure>
  )
}

<style>
  .route-layout {
    display: grid;
    gap: 1rem;
    align-items: center;
  }

  .route-map {
    position: relative;
    margin-inline: auto;
    width: min(100%, 26rem);
  }

  .route-map svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .map-label {
    position: absolute;
    border-radius: 999px;
    background: rgb(255 255 255 / 92%);
    padding: 0.2rem 0.5rem;
    color: #292524;
    font-size: 0.7rem;
    font-weight: 800;
    box-shadow: 0 1px 3px rgb(0 0 0 / 18%);
  }

  .map-label--start {
    bottom: 3%;
    left: 54%;
  }

  .map-label--post {
    top: 25%;
    right: 1%;
  }

  .route-steps {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .route-steps li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: center;
    gap: 0.65rem;
    border: 1px solid #d6d3d1;
    border-radius: 0.75rem;
    background: rgb(255 255 255 / 92%);
    padding: 0.65rem;
  }

  .route-steps span {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 50%;
    background: #075985;
    color: white;
    font-weight: 900;
  }

  .route-steps strong {
    color: #292524;
    font-size: 0.9rem;
    line-height: 1.25;
  }

  .train-grid {
    display: grid;
    gap: 0.8rem;
  }

  .movement-card {
    min-width: 0;
    overflow: hidden;
    border: 2px solid #a8a29e;
    border-radius: 0.85rem;
    background: rgb(255 255 255 / 92%);
  }

  .movement-card header {
    display: grid;
    gap: 0.1rem;
    padding: 0.7rem 0.75rem 0.2rem;
    text-align: center;
  }

  .movement-card small {
    color: #78716c;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .movement-card strong {
    color: #292524;
    font-size: 1.05rem;
  }

  .movement-card svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .movement-card p {
    margin: 0;
    padding: 0 0.75rem 0.75rem;
    color: #57534e;
    text-align: center;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .movement-card--action {
    border-color: #b45309;
  }

  .movement-card--state {
    border-color: #075985;
  }

  :global([data-theme='dark']) .map-label,
  :global([data-theme='dark']) .route-steps li,
  :global([data-theme='dark']) .movement-card {
    border-color: #57534e;
    background: rgb(41 37 36 / 94%);
    color: #f5f5f4;
  }

  :global([data-theme='dark']) .map-label,
  :global([data-theme='dark']) .route-steps strong,
  :global([data-theme='dark']) .movement-card strong {
    color: #f5f5f4;
  }

  :global([data-theme='dark']) .movement-card p,
  :global([data-theme='dark']) .movement-card small {
    color: #d6d3d1;
  }

  @media (min-width: 640px) {
    .route-layout {
      grid-template-columns: minmax(0, 1.35fr) minmax(12rem, 0.9fr);
    }

    .train-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
